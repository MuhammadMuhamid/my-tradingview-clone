AWS_REGION=ap-southeast-1
LOG_GROUP=/srtrend/app
DOMAIN_NAME=chart.example.com

# ── sign-in ──
# Cookie-session auth (replaced Caddy basic_auth, which kept signing you out).
# Generate the hash with:  cd backend && npm run hash-password -- 'your password'
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=scrypt$REPLACE_SALT_HEX$REPLACE_KEY_HEX
# Signs the session cookie. Any random string of 32+ chars; changing it signs
# every device out. Generate with:  openssl rand -base64 48
SESSION_SECRET=REPLACE_WITH_32_PLUS_RANDOM_CHARS

DATABASE_URL=postgres://platform:REPLACE@db.example:5432/platform?sslmode=require
ALERT_ENCRYPTION_KEY=REUSE_THE_EXISTING_KEY_EXACTLY

# ── moving-average price alerts ──
MA_ALERTS_ENABLED=true
# Contact address embedded in Web Push requests, per the VAPID spec.
VAPID_SUBJECT=mailto:you@example.com

BACKEND_IMAGE=000000000000.dkr.ecr.ap-southeast-1.amazonaws.com/srtrend-backend:latest
FRONTEND_IMAGE=000000000000.dkr.ecr.ap-southeast-1.amazonaws.com/srtrend-frontend:latest

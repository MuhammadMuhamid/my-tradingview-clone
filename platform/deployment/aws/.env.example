# ─────────────────────────────────────────────────────────────────────────────
# Production identifiers for the scripts in this directory.
#
# Copy to `.env` on the machine that runs them. `.env` is untracked and must
# stay that way: none of these is a credential, but together they name the exact
# hosts that terminate the money path (finding X-11).
#
# NO SECRET BELONGS IN THIS FILE. Passwords, the webhook secret, Binance keys,
# the database password and ALERT_ENCRYPTION_KEY are all fetched at runtime from
# Secrets Manager or the stack bucket — never stored here.
# ─────────────────────────────────────────────────────────────────────────────

# AWS region the stack lives in, e.g. ap-south-1
REGION=

# AWS account id — used only to build the Secrets Manager ARN.
AWS_ACCOUNT_ID=

# CloudFormation stack name.
STACK_NAME=

# EC2 instance id hosting Caddy, the frontend, the API and the live runner.
APP_INSTANCE=

# EC2 instance id intended for the continuous optimizers.
COMPUTE_INSTANCE=

# RDS instance identifier (not the endpoint) used for snapshots.
DB_ID=

# RDS endpoint hostname.
DB_HOST=

# Secrets Manager ARN holding the database credentials.
DB_SECRET=

# S3 bucket created by the stack, used for deploy bundles and backend.env.
BUCKET=

# Public hostname served by Caddy.
DOMAIN=

# Runtime root on the app instance. Rarely needs changing.
REMOTE_ROOT=/opt/srtrend

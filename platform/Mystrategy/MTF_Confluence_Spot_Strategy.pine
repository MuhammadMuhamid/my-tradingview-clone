//@version=6
// =====================================================================================================================
//  MTF CONFLUENCE SPOT STRATEGY  v2  —  modular, per-filter timeframes, toggle-selected confluence
// =====================================================================================================================
//  LONG ONLY. SPOT ONLY. No strategy.short anywhere in this file.
//
//  v2 CHANGES vs v1
//  ----------------
//   * Every gate (G1-G4) and every structure filter (S1-S7) now has its OWN timeframe input. Nothing is hardwired
//     to 1H or 15m any more — set each filter to whatever TF you want to test.
//   * Every filter lives in its OWN numbered section with its own enable toggle.
//   * The Confluence Weights / score / threshold engine is GONE. Selection is now pure AND-of-enabled-filters:
//     a filter you switch on must pass; a filter you switch off is ignored entirely. What you tick is what you get.
//   * Sections ported from "MA + R:R Strategy" so both scripts tune the same way:
//       1 General · 1b Profit-run limit · 6e Volume filter · 6f Higher-high structure · 7 Entries-Long ·
//       9b R:R swing-low stop + ratio TP · 11 Peak/spike filters · 20 AlphaTrend · Heikin-Ashi signal option
//   * Two selectable stop/TP engines: the MA_RR-style R:R bracket (default) or the v1 structural-stop engine.
//
//  ATTRIBUTION (mandatory — do not strip)
//  -------------------------------------
//    "Supertrend"                                  — TradingView / Everget style ATR trailing stop
//    "Support and Resistance (High Volume Boxes)"  — (c) ChartPrime        — Mozilla Public License 2.0
//    "Liquidity Sweeps [LuxAlgo]"                  — (c) LuxAlgo           — CC BY-NC-SA 4.0
//    "Pivot Point SuperTrend"                      — (c) LonesomeTheBlue   — Mozilla Public License 2.0
//    "Buyside & Sellside Liquidity [LuxAlgo]"      — (c) LuxAlgo           — CC BY-NC-SA 4.0
//    "Supply and Demand Visible Range [LuxAlgo]"   — (c) LuxAlgo           — CC BY-NC-SA 4.0
//    "Pivot Points High Low [LuxAlgo]"             — (c) LuxAlgo           — CC BY-NC-SA 4.0
//    "Bollinger Bands" / "Relative Strength Index" — (c) TradingView built-ins
//    "Volume Flow Indicator [LazyBear]"            — (c) LazyBear
//    "AlphaTrend"                                  — (c) KivancOzbilgic
//  CC BY-NC-SA 4.0 is NON-COMMERCIAL: this script may not be sold, licensed for money, or bundled into a paid
//  product or service. Personal / non-commercial use only. Derivatives must be shared alike.
//
//  DELIBERATE DEVIATIONS (see README)
//  ----------------------------------
//   1) Supply & Demand is rewritten from "visible range" to a FIXED ROLLING LOOKBACK, and intrabar volume
//      distribution is replaced with bar-level volume spread across the bins each bar's high-low range spans.
//      Zones are close to, but not identical to, the LuxAlgo original. This is what makes it backtestable.
//   2) HTF components draw nothing — Pine cannot create boxes/lines/labels inside request.security(). HTF values
//      drive the LOGIC; the chart-timeframe instance of each component drives the VISUALS.
//   3) RSI / VFI have no separate pane (overlay strategy). Both are in the Data Window and the debug table.
// =====================================================================================================================

strategy("MTF Confluence Spot Strategy", "MTF Conf", overlay = true,
     default_qty_type        = strategy.cash,
     default_qty_value       = 1000,
     initial_capital         = 10000,
     currency                = currency.USD,
     commission_type         = strategy.commission.percent,
     commission_value        = 0.1,
     slippage                = 2,
     pyramiding              = 0,
     calc_on_every_tick      = false,
     calc_on_order_fills     = false,
     process_orders_on_close = true,
     max_bars_back           = 1000,
     max_boxes_count         = 500,
     max_lines_count         = 500,
     max_labels_count        = 500)


// =====================================================================================================================
//  GROUPS
// =====================================================================================================================
string G_GEN   = "1 General"
string G_RUN   = "1b Profit-run limit (winning cluster cap)"
string G_RISK  = "2 Risk & position sizing"
string G_G1    = "3 G1 — Supertrend regime"
string G_G2    = "4 G2 — RSI regime"
string G_G3    = "5 G3 — VFI (volume flow) regime"
string G_G4    = "6 G4 — Price at/above SR support"
string G_VOL   = "6e Volume filter"
string G_HH    = "6f Higher-high structure"
string G_S1    = "7 S1 — Liquidity sweep [LuxAlgo]"
string G_S2    = "8 S2 — Demand zone (Supply/Demand)"
string G_S3    = "9 S3 — Support box [ChartPrime]"
string G_S4    = "10 S4 — Supertrend structure"
string G_S5    = "11 S5 — Pivot Point Supertrend"
string G_S6    = "12 S6 — Sellside liquidity [LuxAlgo]"
string G_S7    = "13 S7 — Pivot low [LuxAlgo]"
string G_TRIG  = "14 Entry trigger (Bollinger / Supertrend)"
string G_ENT   = "7b Entries — Long"
string G_RR    = "9b R:R — swing-low stop + ratio TP"
string G_STRUCT= "9c Structure-stop engine (alternative)"
string G_SPIKE = "11b Peak / spike filters (anti-chase)"
string G_AT    = "20 Indicator — AlphaTrend"
string G_EXIT  = "21 Exits — signal based"
string G_VIS   = "30 Visualization"
string G_DBG   = "31 Debug"


// =====================================================================================================================
//  1 GENERAL
// =====================================================================================================================
useBarConfirm        = input.bool(true, "Signals on confirmed bar only", group = G_GEN,
     tooltip = "OFF = entry conditions can go true every tick → same-bar stop/re-entry loops and many webhooks. Keep ON for live.")
ordersOnConfirmedBar = input.bool(true, "New entries: bar close only (3Commas)", group = G_GEN,
     tooltip = "When ON, only strategy.entry waits for barstate.isconfirmed. Exits are not delayed.")
cooldownBarsAfterExit= input.int(0, "Min bars after exit before new entry", minval = 0, maxval = 200, group = G_GEN)

htfClosed = input.bool(true, "HTF reads: last CLOSED bar only (no repaint)", group = G_GEN,
     tooltip = "ON  = every higher-timeframe value is taken from the last CLOSED bar ([1] offset). Backtest matches live. STRONGLY recommended.\nOFF = reads the in-progress HTF bar: signals will look better historically and repaint live. Only use to eyeball what a filter is doing.")
useHeikin = input.bool(false, "Signals from Heikin Ashi candles", group = G_GEN,
     tooltip = "Feeds Heikin-Ashi OHLC into the entry TRIGGER (Bollinger / Supertrend flip) instead of real candles. Smoother, later, fewer false triggers. Stops, targets and fills always use REAL prices.")

useChoppyFilter = input.bool(false, "Pause entries after N consecutive losses", group = G_GEN,
     tooltip = "After N losing trades in a row, block new entries for the pause below. Detects choppy / distribution phases that still look bullish on the macro filters.")
maxConsecLoss   = input.int(2,  "Max consecutive losses before pause", minval = 1, maxval = 10, group = G_GEN)
choppyPauseBars = input.int(20, "Pause duration (bars) after max losses hit", minval = 1, maxval = 500, group = G_GEN,
     tooltip = "On a 5m chart 20 bars = 100 minutes.")

signal_delivery  = input.string("Off", "Signal delivery", options = ["3Commas Signal Bot", "Custom webhook bot", "Off"], group = G_GEN,
     tooltip = "3Commas: add a TradingView alert manually with 3Commas JSON + webhook. Custom: JSON via Pine alert().")
string ALERT_SECRET   = input.string("REPLACE_ME", "[Custom bot] secret → WEBHOOK_SECRET", group = G_GEN, display = display.none)
float  alert_buy_usdt = input.float(800.0, "[Custom bot] BUY quote USDT", minval = 1, step = 1, group = G_GEN, display = display.none)
float  alert_sell_base= input.float(0.001, "[Custom bot] SELL base qty", minval = 0.00000001, step = 0.001, group = G_GEN, display = display.none)
string alert_symbol   = input.string("ZECUSDT", "[Custom bot] symbol", group = G_GEN, display = display.none)
use_custom_webhook    = signal_delivery == "Custom webhook bot"


// =====================================================================================================================
//  1b PROFIT-RUN LIMIT
// =====================================================================================================================
useRunLimit     = input.bool(false, "Stop entries after a profitable winning run", group = G_RUN,
     tooltip = "After N consecutive winners that together made at least the profit % below, pause new entries. Targets the last 'top' trade of a winning cluster. A loss resets the streak.")
runLimTrades    = input.int(5,   "Winning trades in the run", minval = 1, maxval = 50, group = G_RUN)
runLimProfitPct = input.float(9.0,"Min combined profit % of the run", step = 0.5, minval = 0, group = G_RUN)
runLimPauseBars = input.int(30,  "Pause new entries for N bars after cap hit", minval = 1, maxval = 5000, group = G_RUN)


// =====================================================================================================================
//  2 RISK & POSITION SIZING
// =====================================================================================================================
sizingMode = input.string("Fixed USDT", "Sizing Mode", options = ["Fixed USDT", "Risk % of Equity"], group = G_RISK)
tradeAmt   = input.float(1000.0, "Trade Amount (USDT)", group = G_RISK, minval = 1, step = 50)
riskPct    = input.float(1.0,    "Risk % of Equity",    group = G_RISK, minval = 0.01, maxval = 100, step = 0.1)
atrLenRisk = input.int(14, "ATR length (risk)", minval = 1, group = G_RISK)
stopEngine = input.string("R:R (swing low + ratio)", "Stop / TP engine",
     options = ["R:R (swing low + ratio)", "Structure (S1-S7 levels)"], group = G_RISK,
     tooltip = "R:R  = MA_RR-style bracket: stop below the recent swing low, target at a reward:risk ratio. Simple, predictable, easy to optimise.\nStructure = v1 engine: the stop is taken from whichever enabled S1-S7 filter level sits closest below entry, with R-multiple partials.")


// =====================================================================================================================
//  3 G1 — SUPERTREND REGIME
// =====================================================================================================================
useG1     = input.bool(true, "G1 · Enable — Supertrend must be bullish", group = G_G1)
g1_tf     = input.timeframe("60", "G1 timeframe", group = G_G1, tooltip = "Blank = chart timeframe.")
g1_atrLen = input.int(10,  "G1 ATR period", minval = 1, group = G_G1)
g1_mult   = input.float(3.0,"G1 ATR multiplier", step = 0.1, minval = 0.1, group = G_G1)
g1_chgAtr = input.bool(true,"G1 change ATR calculation method?", group = G_G1)

// =====================================================================================================================
//  4 G2 — RSI REGIME
// =====================================================================================================================
useG2    = input.bool(true, "G2 · Enable — RSI above threshold", group = G_G2)
g2_tf    = input.timeframe("60", "G2 timeframe", group = G_G2)
g2_len   = input.int(14, "G2 RSI length", minval = 1, group = G_G2)
g2_thr   = input.float(50.0, "G2 RSI threshold", minval = 0, maxval = 100, step = 1, group = G_G2)
g2_max   = input.float(100.0,"G2 RSI max (blocks overbought chasing)", minval = 0, maxval = 100, step = 1, group = G_G2,
     tooltip = "Set to e.g. 70 to refuse entries when RSI is already exhausted. 100 = no upper bound.")

// =====================================================================================================================
//  5 G3 — VFI REGIME
// =====================================================================================================================
useG3     = input.bool(true, "G3 · Enable — VFI above level", group = G_G3)
g3_tf     = input.timeframe("60", "G3 timeframe", group = G_G3)
g3_len    = input.int(130, "G3 VFI length", minval = 1, group = G_G3,
     tooltip = "LazyBear default 130. Needs ~130 CLOSED bars of this timeframe before it means anything; until then the gate reads false.")
g3_coef   = input.float(0.2, "G3 VFI coef", step = 0.05, group = G_G3)
g3_vcoef  = input.float(2.5, "G3 VFI max volume cutoff", step = 0.1, group = G_G3)
g3_sig    = input.int(5, "G3 VFI signal length", minval = 1, group = G_G3)
g3_smooth = input.bool(false, "G3 smooth VFI", group = G_G3)
g3_level  = input.float(0.0, "G3 VFI must be above", step = 0.5, group = G_G3)

// =====================================================================================================================
//  6 G4 — PRICE AT/ABOVE SR SUPPORT
// =====================================================================================================================
useG4      = input.bool(false, "G4 · Enable — price at/above SR support", group = G_G4)
g4_tf      = input.timeframe("60", "G4 timeframe", group = G_G4)
g4_lb      = input.int(20, "G4 SR lookback (pivot length)", minval = 1, group = G_G4,
     tooltip = "Pivot confirmation delay = this many bars of the G4 timeframe.")
g4_volLen  = input.int(2,  "G4 delta-volume filter length", minval = 1, group = G_G4)
g4_boxW    = input.float(1.0, "G4 box width", minval = 0, step = 0.1, group = G_G4)
g4_atrMult = input.float(1.0, "G4 tolerance (ATR mult below support)", minval = 0, step = 0.1, group = G_G4)

// =====================================================================================================================
//  6e VOLUME FILTER
// =====================================================================================================================
useVolumeFilter = input.bool(false, "Require above-average volume on entry", group = G_VOL)
volTf           = input.timeframe("15", "Volume timeframe (blank = chart)", group = G_VOL)
volMaLen        = input.int(50, "Volume SMA length", minval = 5, group = G_VOL)
volMultMin      = input.float(1.5, "Min volume (× SMA)", step = 0.1, minval = 0.1, group = G_VOL,
     tooltip = "1.0 = at-least-average volume; 1.5 = 50% above average.")

// =====================================================================================================================
//  6f HIGHER-HIGH STRUCTURE
// =====================================================================================================================
useHhStructure = input.bool(false, "Require higher-high structure", group = G_HH,
     tooltip = "Last confirmed pivot high on the chosen TF must be above the prior pivot high.")
hhTf           = input.timeframe("15", "Higher-high timeframe", group = G_HH)
hhPivotLen     = input.int(10, "Pivot length (HH TF)", minval = 3, maxval = 30, group = G_HH)

// =====================================================================================================================
//  7 S1 — LIQUIDITY SWEEP
// =====================================================================================================================
useS1     = input.bool(true, "S1 · Enable — bullish liquidity sweep", group = G_S1)
s1_tf     = input.timeframe("15", "S1 timeframe", group = G_S1)
s1_len    = input.int(5, "S1 swings (pivot length)", minval = 1, group = G_S1,
     tooltip = "Pivot confirmation delay = this many bars of the S1 timeframe. 5 bars on 15m = 75 minutes.")
s1_maxAge = input.int(12, "S1 max bars since sweep", minval = 1, group = G_S1,
     tooltip = "The sweep only counts as active if it confirmed within this many CLOSED bars of the S1 timeframe.")

// =====================================================================================================================
//  8 S2 — DEMAND ZONE
// =====================================================================================================================
useS2    = input.bool(true, "S2 · Enable — inside / just above demand zone", group = G_S2)
s2_tf    = input.timeframe("15", "S2 timeframe", group = G_S2)
s2_lb    = input.int(300, "S2 lookback bars (rolling window)", minval = 20, maxval = 900, group = G_S2,
     tooltip = "Replaces LuxAlgo's visible-range window with a fixed rolling window so results are reproducible.")
s2_res   = input.int(50, "S2 resolution (profile bins)", minval = 2, maxval = 200, group = G_S2)
s2_thr   = input.float(10.0, "S2 threshold %", minval = 0, maxval = 100, step = 0.5, group = G_S2)
s2_every = input.int(10, "S2 recalculate every N bars", minval = 1, group = G_S2,
     tooltip = "The volume profile is expensive. Recomputing every N bars bounds execution time; levels are held between recomputes.")
s2_prox  = input.float(1.0, "S2 proximity above demand top (ATR mult)", minval = 0, step = 0.25, group = G_S2)

// =====================================================================================================================
//  9 S3 — SUPPORT BOX
// =====================================================================================================================
useS3     = input.bool(true, "S3 · Enable — at / above support box", group = G_S3)
s3_tf     = input.timeframe("15", "S3 timeframe", group = G_S3)
s3_lb     = input.int(20, "S3 SR lookback (pivot length)", minval = 1, group = G_S3)
s3_volLen = input.int(2,  "S3 delta-volume filter length", minval = 1, group = G_S3)
s3_boxW   = input.float(1.0, "S3 box width", minval = 0, step = 0.1, group = G_S3)
s3_prox   = input.float(1.5, "S3 proximity above support top (ATR mult)", minval = 0, step = 0.25, group = G_S3)

// =====================================================================================================================
//  10 S4 — SUPERTREND STRUCTURE
// =====================================================================================================================
useS4     = input.bool(true, "S4 · Enable — Supertrend bullish", group = G_S4)
s4_tf     = input.timeframe("15", "S4 timeframe", group = G_S4)
s4_atrLen = input.int(10, "S4 ATR period", minval = 1, group = G_S4)
s4_mult   = input.float(3.0, "S4 ATR multiplier", step = 0.1, minval = 0.1, group = G_S4)
s4_chgAtr = input.bool(true, "S4 change ATR calculation method?", group = G_S4)

// =====================================================================================================================
//  11 S5 — PIVOT POINT SUPERTREND
// =====================================================================================================================
useS5    = input.bool(true, "S5 · Enable — Pivot Point Supertrend bullish", group = G_S5)
s5_tf    = input.timeframe("15", "S5 timeframe", group = G_S5)
s5_prd   = input.int(2, "S5 pivot point period", minval = 1, maxval = 50, group = G_S5)
s5_factor= input.float(3.0, "S5 ATR factor", minval = 0.1, step = 0.1, group = G_S5)
s5_pd    = input.int(10, "S5 ATR period", minval = 1, group = G_S5)

// =====================================================================================================================
//  12 S6 — SELLSIDE LIQUIDITY
// =====================================================================================================================
useS6     = input.bool(true, "S6 · Enable — sellside liquidity resting below", group = G_S6)
s6_tf     = input.timeframe("15", "S6 timeframe", group = G_S6)
s6_len    = input.int(7, "S6 detection length", minval = 3, maxval = 13, group = G_S6)
s6_margin = input.float(6.9, "S6 margin", minval = 4, maxval = 9, step = 0.1, group = G_S6)
s6_vis    = input.int(3, "S6 # levels kept", minval = 1, maxval = 50, group = G_S6)
s6_prox   = input.float(5.0, "S6 max distance to level (ATR mult)", minval = 0, step = 0.5, group = G_S6)

// =====================================================================================================================
//  13 S7 — PIVOT LOW
// =====================================================================================================================
useS7  = input.bool(true, "S7 · Enable — above last confirmed pivot low", group = G_S7)
s7_tf  = input.timeframe("15", "S7 timeframe", group = G_S7)
s7_len = input.int(20, "S7 pivot length", minval = 1, group = G_S7,
     tooltip = "LuxAlgo's original default is 50. 20 cuts the confirmation lag: 20 bars on 15m = 5 hours.")

// =====================================================================================================================
//  14 ENTRY TRIGGER
// =====================================================================================================================
useTrigger  = input.bool(true, "Enable entry trigger", group = G_TRIG,
     tooltip = "OFF = entries fire on the first bar where all enabled filters agree, with no timing trigger at all. Expect many more trades.")
trig_tf     = input.timeframe("", "Trigger timeframe (blank = chart)", group = G_TRIG)
trigMode    = input.string("Bollinger Reclaim", "Trigger mode", group = G_TRIG,
     options = ["Bollinger Reclaim", "Bollinger Basis Cross", "Supertrend Flip", "BB + Supertrend (both)"])
bbReclaimLb = input.int(3, "BB reclaim lookback (bars)", minval = 1, group = G_TRIG)
bb_len      = input.int(20, "BB length", minval = 1, group = G_TRIG)
bb_maTyp    = input.string("SMA", "BB basis MA type", options = ["SMA", "EMA", "SMMA (RMA)", "WMA", "VWMA"], group = G_TRIG)
bb_mult     = input.float(2.0, "BB stdev", minval = 0.001, maxval = 50, step = 0.1, group = G_TRIG)
trig_stLen  = input.int(10, "Trigger Supertrend ATR period", minval = 1, group = G_TRIG)
trig_stMult = input.float(3.0, "Trigger Supertrend multiplier", step = 0.1, minval = 0.1, group = G_TRIG)
reqST5      = input.bool(true, "Require trigger-TF Supertrend bullish", group = G_TRIG)

// =====================================================================================================================
//  7b ENTRIES — LONG
// =====================================================================================================================
long_en          = input.bool(true, "Enable longs", group = G_ENT)
useBodyFilter    = input.bool(true, "Body filter: reject bearish entry bar", group = G_ENT,
     tooltip = "Skips entries where the trigger bar is bearish AND its body (open−close) exceeds the multiple of ATR below. A big bearish close on the setup bar is a momentum warning.")
entryBodyAtrMult = input.float(0.4, "Body filter: max bearish body size (× ATR)", step = 0.05, minval = 0.05, group = G_ENT)
useOneTradePerSignal = input.bool(false, "One trade per AlphaTrend / trigger buy signal", group = G_ENT,
     tooltip = "After a long is taken, no new long until a FRESH buy event fires on an enabled indicator.")

// =====================================================================================================================
//  9b R:R — SWING-LOW STOP + RATIO TP
// =====================================================================================================================
rrSwingLb    = input.int(20, "Swing low lookback (bars)", minval = 2, maxval = 200, group = G_RR)
rrBufAtr     = input.float(1.0, "SL buffer below swing low (× ATR)", step = 0.05, minval = 0.0, group = G_RR)
rrRatio      = input.float(2.0, "Reward : Risk ratio (TP)", step = 0.25, minval = 0.25, group = G_RR)
minSlDistAtr = input.float(0.25, "Floor: min SL distance from entry (× ATR)", step = 0.05, minval = 0.05, group = G_RR)
rrUsePartialTp = input.bool(false, "Take partial TPs (%) — TP1 / TP2 + runner", group = G_RR)
rrTp1Pct  = input.float(2.0,  "TP1 — price move %", step = 0.1, minval = 0.1, group = G_RR, inline = "rtp1")
rrTp1Size = input.float(40.0, "close % of pos",     step = 5, minval = 1, maxval = 100, group = G_RR, inline = "rtp1")
rrTp2Pct  = input.float(4.0,  "TP2 — price move %", step = 0.1, minval = 0.1, group = G_RR, inline = "rtp2")
rrTp2Size = input.float(30.0, "close % of pos",     step = 5, minval = 1, maxval = 100, group = G_RR, inline = "rtp2")
rrUseTrailSl  = input.bool(false, "Trailing stop (%)", group = G_RR)
rrTrailPct    = input.float(3.0, "Trailing stop distance (%)", step = 0.1, minval = 0.1, group = G_RR)
rrTrailActPct = input.float(0.0, "Trailing: activate after +% in profit (0 = once green)", step = 0.1, minval = 0.0, group = G_RR)
rrUseBE       = input.bool(true, "Move stop to break-even after +R", group = G_RR)
rrBeAfterR    = input.float(1.0, "Break-even trigger (R)", step = 0.25, minval = 0.1, group = G_RR)
rrBeOffR      = input.float(0.1, "Break-even offset (R)", step = 0.05, minval = 0, group = G_RR)
plotRR        = input.bool(true, "Plot R:R levels (live SL + TP)", group = G_RR)

// =====================================================================================================================
//  9c STRUCTURE-STOP ENGINE (alternative)
// =====================================================================================================================
slSource   = input.string("Nearest structure", "Stop source", group = G_STRUCT,
     options = ["Nearest structure", "Furthest structure", "S1 sweep low", "S2 demand bottom", "S3 support bottom", "ATR"])
slAtrMult  = input.float(2.0, "ATR stop multiplier", minval = 0.1, step = 0.1, group = G_STRUCT)
slBufAtr   = input.float(0.25,"SL buffer (ATR mult)", minval = 0, step = 0.05, group = G_STRUCT)
minStopPct = input.float(0.3, "Min stop distance %", minval = 0, step = 0.05, group = G_STRUCT)
maxStopPct = input.float(3.0, "Max stop distance %", minval = 0.1, step = 0.1, group = G_STRUCT)
tooTight   = input.string("Widen", "On too-tight stop", options = ["Widen", "Skip Trade"], group = G_STRUCT)
stTp1R   = input.float(1.0, "TP1 R multiple", minval = 0.1, step = 0.1, group = G_STRUCT)
stTp1Pct = input.float(40.0,"TP1 % of position", minval = 1, maxval = 99, step = 1, group = G_STRUCT)
stTp2R   = input.float(2.0, "TP2 R multiple", minval = 0.1, step = 0.1, group = G_STRUCT)
stTp2Pct = input.float(30.0,"TP2 % of position", minval = 1, maxval = 99, step = 1, group = G_STRUCT)
stTp3R   = input.float(3.0, "TP3 R multiple (runner)", minval = 0.1, step = 0.1, group = G_STRUCT)
stUsePartials = input.bool(true, "Enable partial take profit", group = G_STRUCT)
pctBasis = input.string("Original Position", "Partial % basis", options = ["Original Position", "Remaining Position"], group = G_STRUCT,
     tooltip = "Pine's qty_percent is a % of the position REMAINING when the exit executes. 'Original Position' converts your numbers for you.")

// =====================================================================================================================
//  11b PEAK / SPIKE FILTERS
// =====================================================================================================================
usePeakRun   = input.bool(false, "Block entries after parabolic run", group = G_SPIKE,
     tooltip = "Reject a long when price has already risen more than the limit over the last N bars (blow-off top).")
runLb        = input.int(12, "Run lookback (bars)", minval = 2, maxval = 500, group = G_SPIKE)
runMode      = input.string("Percent", "Run measured in", options = ["Percent", "ATR"], group = G_SPIKE)
runMaxPct    = input.float(25.0, "Max rise over lookback (%)", step = 0.5, minval = 0.1, group = G_SPIKE)
runMaxAtr    = input.float(6.0,  "Max rise over lookback (× ATR)", step = 0.5, minval = 0.1, group = G_SPIKE)
useAtrSpike  = input.bool(false, "Block entries on ATR volatility spikes", group = G_SPIKE)
atrSpikeAvgLen  = input.int(20, "ATR spike: average lookback (bars)", minval = 2, group = G_SPIKE)
atrSpikeMaxMult = input.float(1.8, "ATR spike: max ATR (× average)", step = 0.1, minval = 1.0, group = G_SPIKE)
useWickFilter = input.bool(false, "Block entries with large upper wick (rejection)", group = G_SPIKE)
wickMaxAtr    = input.float(2.0, "Max upper wick (× ATR)", step = 0.05, minval = 0.05, group = G_SPIKE)
useExtFilter = input.bool(false, "Block entries too far above MA (over-extension)", group = G_SPIKE)
extRefLen    = input.int(10, "Reference EMA length", minval = 1, group = G_SPIKE)
extMode      = input.string("ATR", "Extension distance mode", options = ["ATR", "Percent"], group = G_SPIKE)
extMaxAtr    = input.float(2.0, "Max distance above EMA (× ATR)", step = 0.1, minval = 0.1, group = G_SPIKE)
extMaxPct    = input.float(5.0, "Max distance above EMA (%)", step = 0.1, minval = 0.1, group = G_SPIKE)

// =====================================================================================================================
//  20 INDICATOR — ALPHATREND
// =====================================================================================================================
at_en      = input.bool(false, "Enable AlphaTrend", group = G_AT)
at_primary = input.bool(false, "AlphaTrend is PRIMARY (entry trigger)", group = G_AT,
     tooltip = "ON = an AlphaTrend buy crossover TRIGGERS entries (replaces the section-14 trigger). OFF = confirming FILTER only (AlphaTrend must be rising).")
at_coeff   = input.float(1.0, "Multiplier", step = 0.1, group = G_AT)
at_ap      = input.int(50, "Common Period", minval = 1, group = G_AT)
at_src     = input.source(close, "Source", group = G_AT)
at_novol   = input.bool(false, "Change calc (no volume data)?", group = G_AT)
at_tf      = input.timeframe("", "Signal timeframe (blank = chart)", group = G_AT)
at_useExit = input.bool(false, "Exit long on AlphaTrend SELL", group = G_AT)
plotAlphaTrend = input.bool(false, "Plot AlphaTrend lines", group = G_AT)

// =====================================================================================================================

//@version=6
// =====================================================================================================================
//  MTF CONFLUENCE SPOT STRATEGY — LEAN
//  Long only. Spot only. Per-filter timeframes, toggle-selected confluence, single R:R stop/TP engine.
// =====================================================================================================================
//  This is the trimmed build. Relative to the full version these sections were REMOVED on request:
//      1b Profit-run limit (winning cluster cap)
//      8  S2 — Demand zone (Supply/Demand)          → the whole volume-profile component is gone
//      9  S3 — Support box [ChartPrime]             → the SR component is retained ONLY for gate G4
//      9c Structure-stop engine (alternative)       → the R:R engine is now the only stop/TP engine
//      11b Peak / spike filters (anti-chase)
//      20 Indicator — AlphaTrend
//  Every remaining input's DEFAULT is set to the configuration captured from the live chart, so a fresh
//  "Add to chart" reproduces that setup without touching a single field.
//
//  ATTRIBUTION (mandatory — do not strip)
//  -------------------------------------
//    "Supertrend"                                  — TradingView / Everget style ATR trailing stop
//    "Support and Resistance (High Volume Boxes)"  — (c) ChartPrime        — Mozilla Public License 2.0
//    "Liquidity Sweeps [LuxAlgo]"                  — (c) LuxAlgo           — CC BY-NC-SA 4.0
//    "Pivot Point SuperTrend"                      — (c) LonesomeTheBlue   — Mozilla Public License 2.0
//    "Buyside & Sellside Liquidity [LuxAlgo]"      — (c) LuxAlgo           — CC BY-NC-SA 4.0
//    "Pivot Points High Low [LuxAlgo]"             — (c) LuxAlgo           — CC BY-NC-SA 4.0
//    "Bollinger Bands" / "Relative Strength Index" — (c) TradingView built-ins
//    "Volume Flow Indicator [LazyBear]"            — (c) LazyBear
//  CC BY-NC-SA 4.0 is NON-COMMERCIAL: this script may not be sold, licensed for money, or bundled into a paid
//  product or service. Personal / non-commercial use only. Derivatives must be shared alike.
//
//  NOTES
//  -----
//   * HTF components draw nothing — Pine cannot create boxes/lines/labels inside request.security(). HTF values
//     drive the LOGIC; the chart-timeframe instance of each component drives the VISUALS.
//   * RSI / VFI have no separate pane (overlay strategy). Both are in the Data Window and the debug table.
//   * Updating a script can scramble a placed study's saved inputs (TradingView maps them by position).
//     After updating, REMOVE the study and RE-ADD it rather than trusting carried-over settings.
// =====================================================================================================================

strategy("MTF Confluence Lean", "MTF Lean", overlay = true,
     default_qty_type        = strategy.cash,
     default_qty_value       = 1000,
     initial_capital         = 10000,
     currency                = currency.USD,
     commission_type         = strategy.commission.percent,
     commission_value        = 0.1,
     slippage                = 2,
     pyramiding              = 0,
     calc_on_every_tick      = false,
     calc_on_order_fills     = false,
     process_orders_on_close = true,
     max_bars_back           = 1000,
     max_boxes_count         = 500,
     max_lines_count         = 500,
     max_labels_count        = 500)


// =====================================================================================================================
//  GROUPS
// =====================================================================================================================
string G_GEN  = "1 General"
string G_RISK = "2 Risk & position sizing"
string G_G1   = "3 G1 — Supertrend regime"
string G_G2   = "4 G2 — RSI regime"
string G_G3   = "5 G3 — VFI (volume flow) regime"
string G_G4   = "6 G4 — Price at/above SR support"
string G_VOL  = "6e Volume filter"
string G_HH   = "6f Higher-high structure"
string G_S1   = "7 S1 — Liquidity sweep [LuxAlgo]"
string G_S4   = "10 S4 — Supertrend structure"
string G_S5   = "11 S5 — Pivot Point Supertrend"
string G_S6   = "12 S6 — Sellside liquidity [LuxAlgo]"
string G_S7   = "13 S7 — Pivot low [LuxAlgo]"
string G_TRIG = "14 Entry trigger (Bollinger / Supertrend)"
string G_ENT  = "7b Entries — Long"
string G_RR   = "9b R:R — swing-low stop + ratio TP"
string G_EXIT = "21 Exits — signal based"
string G_VIS  = "30 Visualization"
string G_DBG  = "31 Debug"


// =====================================================================================================================
//  1 GENERAL
// =====================================================================================================================
useBarConfirm        = input.bool(true, "Signals on confirmed bar only", group = G_GEN,
     tooltip = "OFF = entry conditions can go true every tick → same-bar stop/re-entry loops and many webhooks. Keep ON for live.")
ordersOnConfirmedBar = input.bool(true, "New entries: bar close only (3Commas)", group = G_GEN,
     tooltip = "When ON, only strategy.entry waits for barstate.isconfirmed. Exits are not delayed.")
cooldownBarsAfterExit= input.int(0, "Min bars after exit before new entry", minval = 0, maxval = 200, group = G_GEN)

htfClosed = input.bool(true, "HTF reads: last CLOSED bar only (no repaint)", group = G_GEN,
     tooltip = "ON  = every higher-timeframe value is taken from the last CLOSED bar ([1] offset). Backtest matches live. STRONGLY recommended.\nOFF = reads the in-progress HTF bar: signals look better historically and repaint live. Only use to eyeball what a filter is doing.")
useHeikin = input.bool(false, "Signals from Heikin Ashi candles", group = G_GEN,
     tooltip = "Feeds Heikin-Ashi OHLC into the entry TRIGGER only. Smoother, later, fewer false triggers. Stops, targets and fills always use REAL prices.")

useChoppyFilter = input.bool(false, "Pause entries after N consecutive losses", group = G_GEN,
     tooltip = "After N losing trades in a row, block new entries for the pause below. Detects choppy phases that still look bullish on the macro filters.")
maxConsecLoss   = input.int(1,  "Max consecutive losses before pause", minval = 1, maxval = 10, group = G_GEN)
choppyPauseBars = input.int(20, "Pause duration (bars) after max losses hit", minval = 1, maxval = 500, group = G_GEN,
     tooltip = "On a 5m chart 20 bars = 100 minutes.")

signal_delivery  = input.string("Off", "Signal delivery", options = ["3Commas Signal Bot", "Custom webhook bot", "Off"], group = G_GEN)
string ALERT_SECRET   = input.string("REPLACE_ME", "[Custom bot] secret → WEBHOOK_SECRET", group = G_GEN, display = display.none)
float  alert_buy_usdt = input.float(800.0, "[Custom bot] BUY quote USDT", minval = 1, step = 1, group = G_GEN, display = display.none)
float  alert_sell_base= input.float(0.001, "[Custom bot] SELL base qty", minval = 0.00000001, step = 0.001, group = G_GEN, display = display.none)
string alert_symbol   = input.string("ZECUSDT", "[Custom bot] symbol", group = G_GEN, display = display.none)
use_custom_webhook    = signal_delivery == "Custom webhook bot"


// =====================================================================================================================
//  2 RISK & POSITION SIZING
// =====================================================================================================================
sizingMode = input.string("Fixed USDT", "Sizing Mode", options = ["Fixed USDT", "Risk % of Equity"], group = G_RISK)
tradeAmt   = input.float(1000.0, "Trade Amount (USDT)", group = G_RISK, minval = 1, step = 50)
riskPct    = input.float(1.0,    "Risk % of Equity",    group = G_RISK, minval = 0.01, maxval = 100, step = 0.1)
atrLenRisk = input.int(6, "ATR length (risk)", minval = 1, group = G_RISK,
     tooltip = "Drives the swing-low stop buffer, the minimum stop floor, and the ATR proximity tests.")


// =====================================================================================================================

# Platform frontend configuration for local development.
#
# NO REAL VALUE BELONGS IN THIS FILE — it is tracked in git. The frontend
# deliberately has zero NEXT_PUBLIC_* variables, so nothing here ever reaches
# the browser bundle; `tests/noUnsafeSinks.test.ts` enforces that.

# Backend base URL the Next rewrite proxies /api/* to.
BACKEND_URL=http://localhost:4000

# Page-level sign-in gate, applied in `proxy.ts`.
#
# OPT-OUT, and it uses the identical parse rule as the backend
# (`platform/backend/src/config.ts:parseAuthEnabled`): unset means ENABLED, and
# only the exact string `false` turns it off. `AUTH_ENABLED=1` leaves it on.
#
# Two things this gate is NOT:
#   * It does not verify the cookie signature — the signing secret must not
#     reach the edge runtime. Presence-only is intentional; the backend is the
#     real gate and every protected byte comes from the authenticated API.
#   * It is not a runtime setting in the container. Next inlines process.env
#     into the proxy at BUILD time (see `Dockerfile`), so changing it there
#     needs a rebuild, not a restart.
#
# Set `false` for local development against a backend that also has auth off,
# or the app redirects to a sign-in the backend would not accept.
AUTH_ENABLED=false

{
  "name": "platform-backend",
  "version": "0.1.0",
  "private": true,
  "description": "TradingView-lite backend: Binance data pipeline, strategy engine, backtesting, live alerting",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "migrate": "tsx src/db/migrate.ts",
    "test": "node --env-file=tests/test.env --import tsx --test tests/*.test.ts",
    "hash-password": "tsx src/security/session.ts",
    "lint": "eslint src tests --max-warnings=0",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build",
    "bench:candles": "node --env-file=tests/test.env --import tsx scripts/bench_candles.ts"
  },
  "dependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/web-push": "^3.6.4",
    "bcryptjs": "^3.0.3",
    "dotenv": "^16.4.5",
    "fastify": "^5.10.0",
    "pg": "^8.12.0",
    "web-push": "^3.6.7",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.6",
    "@types/ws": "^8.18.1",
    "eslint": "^9.39.5",
    "tsx": "^4.16.0",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.67.0"
  }
}

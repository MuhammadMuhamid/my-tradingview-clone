# Backend HTTP server
HOST=127.0.0.1
PORT=4000
LOG_LEVEL=info

# Postgres / TimescaleDB (docker-compose default)
DATABASE_URL=postgres://platform:platform@localhost:5433/platform

# Required: encrypts webhook secrets and bot UUIDs at rest.
ALERT_ENCRYPTION_KEY=replace-with-openssl-rand-hex-32
ALLOWED_WEBHOOK_HOSTS=bot.alphawebstudioz.com,api.3commas.io
LIVE_TEST_ENABLED=false

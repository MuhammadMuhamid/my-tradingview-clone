# ─────────────────────────────────────────────────────────────────────────────
# Platform backend configuration.
#
# Copy to `.env` and fill in. NO REAL VALUE BELONGS IN THIS FILE — it is
# tracked in git, and `scripts/ci/scan-secrets.sh` fails the build on a
# credential-shaped literal anywhere in tracked source.
#
# The process refuses to start rather than run half-protected. Every setting
# below that says "required" is enforced at boot in `src/config.ts`.
# ─────────────────────────────────────────────────────────────────────────────

# ── HTTP server ──
HOST=127.0.0.1
PORT=4000
LOG_LEVEL=info

# Set to `production` in a deployed container. It suppresses thrown-error
# detail on 5xx responses and rejects published placeholder secrets outright.
NODE_ENV=development

# Only enable when a reverse proxy you operate sets X-Forwarded-For. With it on,
# the header decides the rate-limit bucket; with it off, every request behind a
# proxy shares one bucket.
TRUST_PROXY=false

# ── Database ──
DATABASE_URL=postgres://platform:platform@localhost:5433/platform

# ── Secrets (required) ──
# Encrypts webhook secrets and bot UUIDs at rest, and is used by the alert
# payload redactor.  Generate with: openssl rand -hex 32
ALERT_ENCRYPTION_KEY=

# ── Authentication ──
# AUTH_ENABLED is OPT-OUT: unset means enabled. ONLY the exact string `false`
# disables the gate, and the frontend applies the identical rule. Leaving this
# unset on a machine with no ADMIN_PASSWORD_HASH is a startup failure, not a
# silently open API — this process exposes the live signal emitter and a
# real-order test endpoint.
AUTH_ENABLED=true
ADMIN_USERNAME=admin

# scrypt or bcrypt hash of the admin password. Required when auth is enabled.
# Generate with: npm run hash-password -- 'your password'
ADMIN_PASSWORD_HASH=

# Signs the session cookie. At least 32 characters, and not a value published
# anywhere. Rotating it signs everyone out — that is the only revocation there
# is, because sessions are stateless.
# Generate with: openssl rand -hex 32
SESSION_SECRET=

# Emit `Secure` on the session cookie. Must be `false` for plain-HTTP local
# development, or the browser drops the cookie and you appear signed out.
# Leave it on (unset or `true`) anywhere with TLS; it also enables HSTS.
COOKIE_SECURE=false

# ── Webhook delivery (required) ──
# Comma-separated hostname allowlist. Delivery is restricted to exactly these
# hosts, over HTTPS, on port 443. There is deliberately no default: a
# production hostname baked into source is an information disclosure, and an
# empty list is a startup failure rather than a silent delivery outage.
ALLOWED_WEBHOOK_HOSTS=

# The manual real-order test endpoint (<= 20 USDT, paused deployments only).
# Leave off unless you are deliberately using it.
LIVE_TEST_ENABLED=false

# ── Live signal emission ──
# The live runner sends real buy/sell instructions to the execution bot.
# See `docs/ARCHITECTURE.md` before enabling it anywhere.
LIVE_RUNNER_ENABLED=false

# ── Manual Binance Spot trading (opt-in) ──
# The platform stores no Binance key. It signs each command to the separately
# deployed execution bot. Configure the identical generated secret there.
MANUAL_TRADING_ENABLED=false
MANUAL_TRADING_BOT_URL=http://localhost:4001
# Generate: openssl rand -hex 32
MANUAL_TRADING_HMAC_SECRET=

# ── Bot authoritative realization ingestion (opt-in) ────────────────────────
REALIZATION_INGESTION_ENABLED=false
# Dedicated server-to-server key; configure the same value on Bot only.
# Generate: openssl rand -hex 32
REALIZATION_HMAC_SECRET=

# ── Web Push (optional) ──
# Omit both and a keypair is generated and stored in app_settings. Set both
# together or neither; a mismatched pair fails every send.
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

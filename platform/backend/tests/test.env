# Deterministic environment for the local test suite.
# Values are non-secret fixtures: never point these at a real database or a real key.
NODE_ENV=test
ALERT_ENCRYPTION_KEY=test-only-alert-encryption-key-0000000000
SESSION_SECRET=test-only-session-secret-000000000000000000
DATABASE_URL=postgres://platform:platform@127.0.0.1:5433/platform_test
AUTH_ENABLED=false
COOKIE_SECURE=false
LIVE_RUNNER_ENABLED=false
LIVE_TEST_ENABLED=false
ALLOWED_WEBHOOK_HOSTS=bot.alphawebstudioz.com,api.3commas.io

# The suite's environment must be exactly this file.
#
# `src/config.ts` imports `dotenv/config`, which reads `backend/.env` from the
# working directory and layers a developer's real settings ON TOP of the
# values above — `--env-file` populates `process.env` first, and dotenv only
# fills in what is still unset. A machine whose `.env` selects Binance's
# public mirror therefore failed two provider-host assertions that are
# correct, while a clean checkout passed them, so a green suite meant
# "green here" rather than "green". `tests/security.test.ts` already spawns
# its children with this same variable for the same reason.
#
# Pointing dotenv at a path that cannot exist makes it a no-op, so every
# variable the suite runs on is declared in this file and nowhere else.
DOTENV_CONFIG_PATH=tests/no-dotenv-under-test.env

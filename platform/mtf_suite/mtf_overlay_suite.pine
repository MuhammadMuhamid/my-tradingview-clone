//@version=6
// =====================================================================================
// MTF OVERLAY SUITE                                        Script A of 2  —  overlay
// -------------------------------------------------------------------------------------
// Modules: 4x SMA, 4x EMA, 3x Supertrend, VWAP, Bollinger Bands, Pivot Points Standard,
//          Support & Resistance (Flux Charts), Trendlines, Auto Fib Retracement.
//
// This is a DERIVATIVE WORK assembled from published scripts. Keep it private /
// invite-only. Do not publish it as original work.
//
//   Support & Resistance module:
//     This Pine Script™ code is subject to the terms of the Mozilla Public License 2.0
//     at https://mozilla.org/MPL/2.0/
//     © fluxchart
//
//   Trendlines module:
//     © Copyright 2019 to present, Joris Duyck (JD)
//
//   Supertrend, Pivot Points Standard, Bollinger Bands, VWAP, moving averages, Auto Fib:
//     ported / adapted from the TradingView built-in scripts.
//
// It is a visualisation tool. It is not a trading system and confers no edge.
//
// ---------------------------- REPAINT WARNING ----------------------------------------
//   * "Confirm HTF values on close" = true (default): the engine requests the last
//     CLOSED higher-timeframe value. Historical bars never change. Values appear up to
//     one HTF bar late.
//   * = false: live HTF values are used. They WILL change intrabar.
// The shift is applied ONLY to modules whose timeframe is above the chart's — see
// engConfirm(). A module running on the chart timeframe is never lagged.
// The only lookahead_on in this file is the Pivot Points request (documented at the
// module). It does not leak future data.
// =====================================================================================
indicator("MTF Overlay Suite", "MTF-O", overlay = true,
     max_lines_count = 500, max_labels_count = 500, max_boxes_count = 500,
     dynamic_requests = true)

// =====================================================================================
// ENGINE INPUTS
// =====================================================================================
const string GRP_ENG = "Engine"

bool engConfirmHTF = input.bool(true, "Confirm HTF values on close", group = GRP_ENG,
     tooltip = "ON (recommended): use the last CLOSED higher-timeframe value. Historical " +
       "values never change.\n\nOFF: use live higher-timeframe values. They WILL change " +
       "intrabar — signals can appear and then disappear before the HTF bar closes.\n\n" +
       "Modules running on the chart timeframe are unaffected either way.")

string engLowerTFMode = input.string("Fall back to chart timeframe", "If a module timeframe is below the chart timeframe",
     options = ["Suppress + warn", "Fall back to chart timeframe"], group = GRP_ENG,
     tooltip = "Requesting a timeframe lower than the chart returns the last value of that " +
       "lower timeframe, which is misleading rather than useful.")

bool engShowDebug = input.bool(false, "Show drawing-object debug table", group = GRP_ENG,
     tooltip = "Live per-module line / label / box counts against each module's cap.")

// =====================================================================================
// TIMEFRAME RESOLUTION AND GUARD
// =====================================================================================
engTfSeconds(simple string tf) =>
    timeframe.in_seconds(tf == "" ? timeframe.period : tf)

engIsLower(simple string tf) =>
    engTfSeconds(tf) < timeframe.in_seconds(timeframe.period)

engResolve(simple string tf) =>
    engIsLower(tf) and engLowerTFMode == "Fall back to chart timeframe" ? "" : tf

engSuppressed(simple string tf) =>
    engIsLower(tf) and engLowerTFMode == "Suppress + warn"

var array<string> engWarnings = array.new<string>()

engWarn(string moduleName, simple string tf) =>
    if barstate.islast and engSuppressed(tf)
        string msg = moduleName + " (" + (tf == "" ? "chart" : tf) + ")"
        if not engWarnings.includes(msg)
            engWarnings.push(msg)
    engSuppressed(tf)

// @function true when the confirm-on-close shift should actually be applied.
//           The shift exists to stop a FORMING higher-timeframe bar from mutating
//           values already drawn. When a module's timeframe resolves to the chart
//           timeframe there is no higher bar to wait for, and shifting would just lag
//           the module by one chart bar for nothing.
engConfirm(simple string tf) =>
    engConfirmHTF and engTfSeconds(engResolve(tf)) > timeframe.in_seconds(timeframe.period)

// =====================================================================================
// MTF REQUEST HELPERS
// =====================================================================================
// Pine cannot pass a tuple expression through a user function, so tuple requests call
// request.security() directly with this exact argument set.
// VERIFIED 2026-08-27 on BINANCE:ZECUSDT 1H: a calculation passed through this wrapper
// is evaluated in the REQUESTED context. 4H SMA20 via engHtfF = 805.3895, identical to
// the direct idiom; the wrong "pull the HTF close down and average it here" form gave
// 790.149.
engHtfF(simple string tf, float expr) =>
    request.security(syminfo.tickerid, engResolve(tf), engConfirm(tf) ? expr[1] : expr,
         gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)

engHtfI(simple string tf, int expr) =>
    request.security(syminfo.tickerid, engResolve(tf), engConfirm(tf) ? expr[1] : expr,
         gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)

engHtfB(simple string tf, bool expr) =>
    request.security(syminfo.tickerid, engResolve(tf), engConfirm(tf) ? expr[1] : expr,
         gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)

// =====================================================================================
// DRAWING-OBJECT CAP MANAGER
// =====================================================================================
type engPool
    string       name
    array<line>  lines
    array<label> labels
    array<box>   boxes
    int          maxLines
    int          maxLabels
    int          maxBoxes

var array<engPool> engPools = array.new<engPool>()

engNewPool(string name, int maxLines, int maxLabels, int maxBoxes) =>
    engPool p = engPool.new(name, array.new<line>(), array.new<label>(), array.new<box>(),
         maxLines, maxLabels, maxBoxes)
    engPools.push(p)
    p

method own(engPool p, line ln) =>
    if not na(ln)
        p.lines.push(ln)
        while p.lines.size() > p.maxLines
            line.delete(p.lines.shift())
    ln

method own(engPool p, label lb) =>
    if not na(lb)
        p.labels.push(lb)
        while p.labels.size() > p.maxLabels
            label.delete(p.labels.shift())
    lb

method own(engPool p, box bx) =>
    if not na(bx)
        p.boxes.push(bx)
        while p.boxes.size() > p.maxBoxes
            box.delete(p.boxes.shift())
    bx

// @function Releases one object from the pool WITHOUT deleting it again. A module that
//           deletes its own drawings must call this, or the pool keeps dead handles:
//           its counts drift high and eviction starts freeing handles that are already
//           gone instead of live ones.
method release(engPool p, line ln) =>
    int i = p.lines.indexof(ln)
    if i >= 0
        p.lines.remove(i)

method release(engPool p, label lb) =>
    int i = p.labels.indexof(lb)
    if i >= 0
        p.labels.remove(i)

method release(engPool p, box bx) =>
    int i = p.boxes.indexof(bx)
    if i >= 0
        p.boxes.remove(i)

method clear(engPool p) =>
    while p.lines.size() > 0
        line.delete(p.lines.shift())
    while p.labels.size() > 0
        label.delete(p.labels.shift())
    while p.boxes.size() > 0
        box.delete(p.boxes.shift())

method recap(engPool p, int maxLines, int maxLabels, int maxBoxes) =>
    p.maxLines  := maxLines
    p.maxLabels := maxLabels
    p.maxBoxes  := maxBoxes
    while p.lines.size()  > p.maxLines
        line.delete(p.lines.shift())
    while p.labels.size() > p.maxLabels
        label.delete(p.labels.shift())
    while p.boxes.size()  > p.maxBoxes
        box.delete(p.boxes.shift())

// =====================================================================================
// DEBUG TABLE  (off by default)
// =====================================================================================
const int ENG_HARD_CAP = 500

var table engTable = table.new(position.top_right, 5, 12, border_width = 1)

engDrawDebug() =>
    if engShowDebug and barstate.islast
        table.clear(engTable, 0, 0, 4, 11)
        table.cell(engTable, 0, 0, "Module", bgcolor = color.new(color.gray, 30), text_color = color.white, text_size = size.small)
        table.cell(engTable, 1, 0, "lines", bgcolor = color.new(color.gray, 30), text_color = color.white, text_size = size.small)
        table.cell(engTable, 2, 0, "labels", bgcolor = color.new(color.gray, 30), text_color = color.white, text_size = size.small)
        table.cell(engTable, 3, 0, "boxes", bgcolor = color.new(color.gray, 30), text_color = color.white, text_size = size.small)
        table.cell(engTable, 4, 0, "cap", bgcolor = color.new(color.gray, 30), text_color = color.white, text_size = size.small)
        int totL = 0
        int totB = 0
        int totX = 0
        int row = 1
        for p in engPools
            if row < 11
                table.cell(engTable, 0, row, p.name, text_color = color.white, text_size = size.small)
                table.cell(engTable, 1, row, str.tostring(p.lines.size()), text_color = color.white, text_size = size.small)
                table.cell(engTable, 2, row, str.tostring(p.labels.size()), text_color = color.white, text_size = size.small)
                table.cell(engTable, 3, row, str.tostring(p.boxes.size()), text_color = color.white, text_size = size.small)
                table.cell(engTable, 4, row, str.tostring(p.maxLines) + "/" + str.tostring(p.maxLabels) + "/" + str.tostring(p.maxBoxes), text_color = color.gray, text_size = size.small)
                row += 1
            totL += p.lines.size()
            totB += p.labels.size()
            totX += p.boxes.size()
        color warnCol = math.max(totL, math.max(totB, totX)) > ENG_HARD_CAP * 4 / 5 ? color.red : color.white
        table.cell(engTable, 0, row, "TOTAL", text_color = warnCol, text_size = size.small)
        table.cell(engTable, 1, row, str.tostring(totL), text_color = warnCol, text_size = size.small)
        table.cell(engTable, 2, row, str.tostring(totB), text_color = warnCol, text_size = size.small)
        table.cell(engTable, 3, row, str.tostring(totX), text_color = warnCol, text_size = size.small)
        table.cell(engTable, 4, row, str.tostring(ENG_HARD_CAP) + " each", text_color = color.gray, text_size = size.small)

var label engWarnLabel = na

// =====================================================================================
// MODULE — MOVING AVERAGES  (4 SMA + 4 EMA, independent timeframe per slot)
// =====================================================================================
const string GRP_MA = "Moving averages"

bool maOn = input.bool(true, "Enable moving averages", group = GRP_MA)

maCalc(simple int len, float src, simple bool isEma) =>
    isEma ? ta.ema(src, len) : ta.sma(src, len)


//@version=6
// ═══════════════════════════════════════════════════════════════════════════════
//  MTF MEAN-REVERSION SCALPER — LONG ONLY — CRYPTO SPOT
// ═══════════════════════════════════════════════════════════════════════════════
//  Concept
//  -------
//  HTF (default 15m) pivot swings define Support / Resistance ZONES.
//  LTF (chart, intended 1m) hunts a specific failure pattern inside the support
//  zone:
//      1. Zone touch      -> LTF low enters/breaches the HTF support zone
//      2. Liquidity sweep -> price trades BELOW a recent LTF swing low, then
//                            reclaims it with momentum (engulf / volume / close
//                            strength)
//      3. Higher low      -> a confirmed LTF pivot low prints ABOVE the sweep low
//                            (market-structure shift). Entry on that close.
//      4. Filters         -> session window, manual news pause, HTF regime
//
//  Non-repainting design
//  ---------------------
//  * All HTF data comes from ONE request.security() call with
//    gaps=barmerge.gaps_off and lookahead=barmerge.lookahead_off.
//  * Inside that call every value is additionally shifted by `htfConfirmOffset`
//    (default 1) so the strategy only ever sees values from a FULLY CLOSED HTF
//    bar. ta.pivothigh/low can flip while the confirming HTF bar is still open,
//    so the [1] shift is what actually removes the repaint — lookahead_off alone
//    does not.
//  * LTF pivots use ta.pivotlow(left, right); they resolve `right` bars late by
//    construction and never rewrite history.
//  * No security() of the CURRENT bar's high/low, no lookahead_on, no
//    calc_on_every_tick.
//
//  Honest cost of that safety: the 15m support level is confirmed
//  htfPivotLen bars AFTER the actual swing (default 10 x 15m = 150 min) plus the
//  1-bar shift. Levels are deliberately "old" — that is what makes them levels.
//
//  ⚠ Backtest caveat: process_orders_on_close = true fills the entry at the
//  close of the signal bar. On a 1m crypto chart the real fill is the next
//  available ask plus spread. Commission (0.1%) and slippage (2 ticks) are
//  modelled, but the TradingView backtester still has no order book, no partial
//  fills and no funding. Treat results as an upper bound.
// ═══════════════════════════════════════════════════════════════════════════════

strategy(
     title                   = "MTF Mean Reversion Scalper — Long Only [Spot]",
     shorttitle              = "MTF MR Scalp L",
     overlay                 = true,
     initial_capital         = 1000,
     currency                = currency.USDT,
     default_qty_type        = strategy.percent_of_equity,
     default_qty_value       = 100,
     commission_type         = strategy.commission.percent,
     commission_value        = 0.1,     // 0.1% spot taker fee (const — also editable in Properties)
     slippage                = 2,       // ticks (const — also editable in Properties)
     pyramiding              = 0,
     margin_long             = 100,     // 100% margin = true spot, no leverage
     margin_short            = 100,
     process_orders_on_close = true,
     calc_on_every_tick      = false,
     max_lines_count         = 500,
     max_labels_count        = 500,
     max_boxes_count         = 500)

// Spot account: hard-block any short entry at the engine level.
strategy.risk.allow_entry_in(strategy.direction.long)


// ═══════════════════════════════════════════════════════════════════════════════
//  1. INPUTS
// ═══════════════════════════════════════════════════════════════════════════════

// ── Higher timeframe / zone mapping ───────────────────────────────────────────
var string GH        = "① HTF Zones (Support / Resistance)"
htfRes               = input.timeframe("15",  "HTF resolution",                      group = GH, tooltip = "Timeframe used to map S/R swings. Must be >= chart timeframe.")
htfPivotLen          = input.int(10,          "HTF pivot length (bars each side)",   minval = 2, maxval = 50, group = GH, tooltip = "ta.pivothigh/low left=right=N on the HTF. Larger = fewer, more significant levels, confirmed later.")
htfConfirmOffset     = input.int(1,           "HTF confirm offset (0=live bar, 1=closed bar)", minval = 0, maxval = 1, group = GH, tooltip = "Keep at 1. 0 lets the still-forming HTF bar move the levels = repainting.")
useAtrZone           = input.bool(true,       "Size zones with ATR (off = %)",       group = GH)
zoneAtrMult          = input.float(0.5,       "Zone half-width — ATR mult",          minval = 0.05, step = 0.05, group = GH)
zonePct              = input.float(0.25,      "Zone half-width — % of price",        minval = 0.01, step = 0.01, group = GH)
htfAtrLen            = input.int(14,          "HTF ATR length",                      minval = 2, group = GH)

// ── Regime filter ─────────────────────────────────────────────────────────────
var string GR        = "② Regime Filter"
useTrendFilter       = input.bool(true,       "HTF trend filter (close > HTF EMA)",  group = GR, tooltip = "Only buy support inside an HTF uptrend. Turning this off means buying dips in downtrends — the classic way this pattern dies.")
htfEmaLen            = input.int(200,         "HTF EMA length",                      minval = 10, group = GR)
useAdxFilter         = input.bool(false,      "HTF ADX ceiling filter",              group = GR, tooltip = "Mean reversion prefers non-trending conditions. Blocks entries when HTF ADX is above the ceiling.")
adxDiLen             = input.int(14,          "ADX — DI length",                     minval = 2, group = GR)
adxSmooth            = input.int(14,          "ADX — smoothing",                     minval = 2, group = GR)
adxMax               = input.float(35.0,      "Max HTF ADX",                         minval = 5.0, step = 1.0, group = GR)

// ── Setup: sweep + higher low ─────────────────────────────────────────────────
var string GS        = "③ Setup — Sweep & Higher Low"
ltfPivotLen          = input.int(5,           "LTF swing-low pivot length",          minval = 1, maxval = 30, group = GS, tooltip = "Defines the 'recent LTF swing low' that gets swept. Also used by the structural trailing stop.")
setupMaxBars         = input.int(60,          "Setup expiry (bars after zone touch)", minval = 5, group = GS)
reclaimMaxBars       = input.int(5,           "Max bars to reclaim swept level",     minval = 1, maxval = 30, group = GS, tooltip = "'Rapid' reversal. Larger = slow bleed below the level still counts as a sweep.")
hlPivotLen           = input.int(2,           "Higher-low pivot length",             minval = 1, maxval = 10, group = GS, tooltip = "Micro pivot used to confirm the HL. Entry fires N bars after the actual low — that lag is the price of non-repainting.")
hlMaxBars            = input.int(20,          "Max bars from reclaim to HL",         minval = 2, group = GS)
requireMss           = input.bool(false,      "Require close above post-sweep high (strict MSS)", group = GS, tooltip = "Stricter: also demand a break of the swing high made after the sweep. Fewer, later, higher-quality entries.")

// ── Momentum confirmation on the reclaim bar ──────────────────────────────────
var string GM        = "④ Reclaim Momentum (any enabled = pass)"
useEngulf            = input.bool(true,       "Bullish engulfing",                   group = GM)
useVolSpike          = input.bool(true,       "Volume spike",                        group = GM)
volMaLen             = input.int(20,          "Volume MA length",                    minval = 2, group = GM)
volMult              = input.float(1.5,       "Volume > MA x",                       minval = 1.0, step = 0.1, group = GM)
useCloseStrength     = input.bool(true,       "Close strength (close in top X of range)", group = GM)
closeStrength        = input.float(0.6,       "Close strength ratio",                minval = 0.1, maxval = 1.0, step = 0.05, group = GM)

// ── Time & news ───────────────────────────────────────────────────────────────
var string GT        = "⑤ Time & News Filters"
pauseTrading         = input.bool(false,      "⛔ PAUSE TRADING (manual news filter)", group = GT, tooltip = "Blocks NEW entries. Open positions keep their SL/TP.")
useTimeFilter        = input.bool(false,      "Enable session window",               group = GT, tooltip = "Crypto is 24/7 — off by default. Turn on to isolate a session.")
sessStartHour        = input.int(9,           "Window start — hour (UTC)",           minval = 0, maxval = 23, group = GT)
sessStartMin         = input.int(30,          "Window start — minute",               minval = 0, maxval = 59, group = GT)
sessEndHour          = input.int(12,          "Window end — hour (UTC)",             minval = 0, maxval = 23, group = GT)
sessEndMin           = input.int(0,           "Window end — minute",                 minval = 0, maxval = 59, group = GT)
closeOnSessionEnd    = input.bool(false,      "Flatten when window closes",          group = GT)

// ── Risk & orders ─────────────────────────────────────────────────────────────
var string GX        = "⑥ Risk & Orders"
useAtrSl             = input.bool(true,       "SL from ATR (off = %)",               group = GX)
slAtrMult            = input.float(0.5,       "SL — ATR mult below sweep low",       minval = 0.05, step = 0.05, group = GX)
slPct                = input.float(0.30,      "SL — % below sweep low",              minval = 0.01, step = 0.01, group = GX)
ltfAtrLen            = input.int(14,          "LTF ATR length",                      minval = 2, group = GX)
maxSlPct             = input.float(2.0,       "Skip trade if SL wider than % of price", minval = 0.1, step = 0.1, group = GX)
tpMode               = input.string("Nearest (Swing High or RR)", "Take profit mode", options = ["Nearest (Swing High or RR)", "RR Target only", "HTF Swing High only"], group = GX)
rrTarget             = input.float(2.0,       "RR target",                           minval = 0.5, step = 0.5, group = GX)
minRr                = input.float(1.2,       "Skip trade if final RR below",        minval = 0.1, step = 0.1, group = GX)
avoidResEntry        = input.bool(true,       "Block entry inside HTF resistance zone", group = GX)
useTimeStop          = input.bool(false,      "Time stop",                           group = GX)
timeStopBars         = input.int(120,         "Close trade after N bars",            minval = 5, group = GX)

// ── Position sizing ───────────────────────────────────────────────────────────
var string GZ        = "⑦ Position Sizing"
useRiskSizing        = input.bool(false,      "Risk-based sizing (off = 100% equity)", group = GZ, tooltip = "OFF reproduces the declared default_qty_value=100 (all-in per trade — aggressive and it inflates compounding). ON sizes each trade so the stop costs exactly Risk %.")
riskPerTrade         = input.float(1.0,       "Risk % of equity per trade",          minval = 0.1, maxval = 10.0, step = 0.1, group = GZ)

// ── Trailing / breakeven ──────────────────────────────────────────────────────
var string GB        = "⑧ Breakeven & Trailing"
useBreakeven         = input.bool(true,       "Move SL to breakeven at R multiple",  group = GB)
beTriggerR           = input.float(1.0,       "Breakeven trigger (R)",               minval = 0.2, step = 0.1, group = GB)
beOffsetPct          = input.float(0.12,      "Breakeven offset % above entry",      minval = 0.0, step = 0.01, group = GB, tooltip = "Cover the 0.1% round-trip fee so 'breakeven' is actually breakeven.")
useStructTrail       = input.bool(true,       "Trail SL under confirmed higher lows", group = GB)
trailBufAtr          = input.float(0.25,      "Trail buffer — ATR mult below pivot", minval = 0.0, step = 0.05, group = GB)

// ── Visuals ───────────────────────────────────────────────────────────────────
var string GV        = "⑨ Visuals"
showZones            = input.bool(true,       "Draw HTF S/R zone boxes",             group = GV)
zoneDrawBars         = input.int(200,         "Zone box left extent (bars)",         minval = 20, group = GV)
zoneExtendRight      = input.int(15,          "Zone box right extent (bars)",        minval = 0, group = GV)
showTradeLines       = input.bool(true,       "Draw SL / TP lines",                  group = GV)
showEntryLabels      = input.bool(true,       "Entry price labels",                  group = GV)
showSweepMarks       = input.bool(true,       "Mark sweeps & higher lows",           group = GV)
showTable            = input.bool(true,       "Dashboard table",                     group = GV)
colSup               = input.color(color.new(color.teal,   80), "Support zone",      group = GV, inline = "c1")
colRes               = input.color(color.new(color.maroon, 80), "Resistance zone",   group = GV, inline = "c1")


// ═══════════════════════════════════════════════════════════════════════════════
//  2. HTF DATA — SINGLE NON-REPAINTING request.security() CALL
// ═══════════════════════════════════════════════════════════════════════════════

// Everything the strategy needs from the HTF, computed in HTF context and then
// shifted by htfConfirmOffset so only CLOSED HTF bars can influence a decision.
f_htfPack() =>
    ph      = ta.pivothigh(high, htfPivotLen, htfPivotLen)   // na except on confirm bar
    pl      = ta.pivotlow(low,   htfPivotLen, htfPivotLen)
    lastPh  = ta.valuewhen(not na(ph), ph, 0)                // most recent confirmed swing high
    lastPl  = ta.valuewhen(not na(pl), pl, 0)                // most recent confirmed swing low
    a       = ta.atr(htfAtrLen)
    e       = ta.ema(close, htfEmaLen)
    [plusDi, minusDi, adxVal] = ta.dmi(adxDiLen, adxSmooth)
    // The [htfConfirmOffset] shift is the actual anti-repaint guard.
    [lastPh[htfConfirmOffset], lastPl[htfConfirmOffset], a[htfConfirmOffset], e[htfConfirmOffset], close[htfConfirmOffset], adxVal[htfConfirmOffset]]

[htfSwingHigh, htfSwingLow, htfAtr, htfEma, htfClose, htfAdx] = request.security(
     syminfo.tickerid, htfRes, f_htfPack(),
     gaps     = barmerge.gaps_off,
     lookahead = barmerge.lookahead_off)

// Guard: an HTF lower than the chart timeframe produces meaningless zones.
htfOk = timeframe.in_seconds(htfRes) >= timeframe.in_seconds(timeframe.period)


// ═══════════════════════════════════════════════════════════════════════════════
//  3. ZONE CONSTRUCTION
// ═══════════════════════════════════════════════════════════════════════════════

// Half-width of a zone around the HTF pivot, in price units.
f_zoneWidth(float anchor) =>
    useAtrZone ? nz(htfAtr) * zoneAtrMult : anchor * zonePct / 100.0

supWidth = na(htfSwingLow)  ? na : f_zoneWidth(htfSwingLow)
resWidth = na(htfSwingHigh) ? na : f_zoneWidth(htfSwingHigh)

supTop = htfSwingLow  + supWidth
supBot = htfSwingLow  - supWidth
resTop = htfSwingHigh + resWidth
resBot = htfSwingHigh - resWidth

supValid = not na(supTop) and not na(supBot) and htfOk
resValid = not na(resTop) and not na(resBot) and htfOk


// ═══════════════════════════════════════════════════════════════════════════════
//  4. LTF BUILDING BLOCKS
// ═══════════════════════════════════════════════════════════════════════════════

ltfAtr = ta.atr(ltfAtrLen)

// Recent LTF swing low — confirmed ltfPivotLen bars after the fact, never repaints.
ltfPl      = ta.pivotlow(low, ltfPivotLen, ltfPivotLen)
lastLtfPl  = ta.valuewhen(not na(ltfPl), ltfPl, 0)

// Micro pivot low used to confirm the higher low.
hlPl = ta.pivotlow(low, hlPivotLen, hlPivotLen)

// ── Reclaim-bar momentum ──────────────────────────────────────────────────────
bullEngulf   = close > open and close[1] < open[1] and close >= open[1] and open <= close[1]
volMa        = ta.sma(volume, volMaLen)
volSpike     = volume > volMa * volMult
barRange     = math.max(high - low, syminfo.mintick)
strongClose  = (close - low) / barRange >= closeStrength

anyMomFilter = useEngulf or useVolSpike or useCloseStrength
momentumOk   = not anyMomFilter or (useEngulf and bullEngulf) or (useVolSpike and volSpike) or (useCloseStrength and strongClose)

// ── Session window (UTC) ──────────────────────────────────────────────────────
f_pad2(v) => (v < 10 ? "0" : "") + str.tostring(v)
sessStr  = f_pad2(sessStartHour) + f_pad2(sessStartMin) + "-" + f_pad2(sessEndHour) + f_pad2(sessEndMin) + ":1234567"
inWindow = not useTimeFilter or not na(time(timeframe.period, sessStr, "UTC"))

// ── Regime ────────────────────────────────────────────────────────────────────
trendOk  = not useTrendFilter or (not na(htfEma) and not na(htfClose) and htfClose > htfEma)
adxOk    = not useAdxFilter   or (not na(htfAdx) and htfAdx <= adxMax)
regimeOk = trendOk and adxOk


// ═══════════════════════════════════════════════════════════════════════════════
//  5. SETUP STATE MACHINE
//     armed -> sweep pending -> sweep reclaimed -> higher low -> ENTRY
// ═══════════════════════════════════════════════════════════════════════════════

// Pine forbids assigning to a global from inside a function, so the setup state
// lives in a UDT: objects are passed by reference, which lets a method mutate
// every field in one place instead of repeating nine resets inline.
type SetupState
    bool  armed      = false   // support zone has been touched, setup is live
    int   armedBar   = na
    bool  sweepPend  = false   // trading below the swept level, awaiting reclaim
    float sweepLow   = na      // running lowest low of the sweep leg
    int   sweepBar   = na
    float sweepRef   = na      // the LTF swing low that got swept
    bool  sweepOk    = false   // reclaim + momentum confirmed, awaiting HL
    int   sweepOkBar = na
    float legHigh    = na      // highest high since the sweep low (for strict MSS)

var SetupState S = SetupState.new()

method reset(SetupState s) =>
    s.armed      := false
    s.armedBar   := na
    s.sweepPend  := false
    s.sweepLow   := na
    s.sweepBar   := na
    s.sweepRef   := na
    s.sweepOk    := false
    s.sweepOkBar := na
    s.legHigh    := na

// Invalidation: price closes decisively under the whole support zone.
zoneLost = supValid and close < supBot - nz(supWidth) * 0.5

// ── Step 1 — zone touch ───────────────────────────────────────────────────────
zoneTouch = supValid and low <= supTop and close > supBot - nz(supWidth)

if zoneTouch and not S.armed and strategy.position_size == 0
    S.armed    := true
    S.armedBar := bar_index

// Expire / invalidate the setup.
if S.armed and (zoneLost or (bar_index - nz(S.armedBar, bar_index)) > setupMaxBars)
    S.reset()

// ── Step 2 — liquidity sweep + reclaim ────────────────────────────────────────
sweepConfirmedNow = false

if S.armed and not S.sweepOk
    // 2a. Push below the recent LTF swing low.
    if not na(lastLtfPl) and low < lastLtfPl
        if not S.sweepPend
            S.sweepPend := true
            S.sweepBar  := bar_index
            S.sweepRef  := lastLtfPl
            S.sweepLow  := low
        else
            S.sweepLow  := math.min(nz(S.sweepLow, low), low)

    // 2b. Reclaim the swept level, back inside the zone, with momentum.
    if S.sweepPend
        S.sweepLow := math.min(nz(S.sweepLow, low), low)
        barsSince = bar_index - nz(S.sweepBar, bar_index)
        reclaimed = close > nz(S.sweepRef, close) and close >= supBot and close > open
        if reclaimed and momentumOk and barsSince <= reclaimMaxBars
            S.sweepOk         := true
            S.sweepOkBar      := bar_index
            S.legHigh         := high
            S.sweepPend       := false
            sweepConfirmedNow := true
        else if barsSince > reclaimMaxBars
            // Too slow to reverse — this was a real breakdown, not a sweep.
            S.sweepPend := false
            S.sweepLow  := na
            S.sweepBar  := na
            S.sweepRef  := na

// ── Step 3 — higher low / market-structure confirmation ───────────────────────
// hlPl confirms hlPivotLen bars after the actual low, so the pivot bar index is
// (bar_index - hlPivotLen). Require it to sit at or after the reclaim bar.
hlPivotBar = bar_index - hlPivotLen
mssOk      = not requireMss or (not na(S.legHigh) and close > S.legHigh)

hlFormed = S.sweepOk and not na(hlPl) and not na(S.sweepLow) and hlPl > S.sweepLow and hlPivotBar >= nz(S.sweepOkBar, bar_index) and (bar_index - nz(S.sweepOkBar, bar_index)) <= hlMaxBars and mssOk

// legHigh is read above, updated after — so `close > legHigh` compares against
// the high made BEFORE this bar.
if S.sweepOk
    S.legHigh := math.max(nz(S.legHigh, high), high)

// Sweep leg invalidated if price loses the sweep low again.
if S.sweepOk and not na(S.sweepLow) and close < S.sweepLow
    S.reset()

// Setup expiry after a confirmed reclaim.
if S.sweepOk and (bar_index - nz(S.sweepOkBar, bar_index)) > hlMaxBars
    S.reset()


// ═══════════════════════════════════════════════════════════════════════════════
//  6. ENTRY / RISK CALCULATION
// ═══════════════════════════════════════════════════════════════════════════════

var float posEntry  = na
var float posStop   = na
var float posTp     = na
var float posRisk   = na
var int   posBar    = na

// Candidate stop: strictly below the lowest point of the sweep leg.
slCandidate = na(S.sweepLow) ? na : (useAtrSl ? S.sweepLow - nz(ltfAtr) * slAtrMult : S.sweepLow * (1.0 - slPct / 100.0))
slCandidate := na(slCandidate) ? na : math.min(slCandidate, S.sweepLow - syminfo.mintick)

riskCandidate = na(slCandidate) ? na : close - slCandidate

// Candidate target.
rrTp    = na(riskCandidate) ? na : close + riskCandidate * rrTarget
swingTp = (not na(htfSwingHigh) and htfSwingHigh > close) ? htfSwingHigh : na

float tpCandidate = na
if not na(rrTp)
    if tpMode == "RR Target only"
        tpCandidate := rrTp
    else if tpMode == "HTF Swing High only"
        tpCandidate := na(swingTp) ? rrTp : swingTp
    else
        // "Nearest": whichever of the two is hit first is simply the closer one.
        tpCandidate := na(swingTp) ? rrTp : math.min(rrTp, swingTp)

// Sanity gates.
riskOk    = not na(riskCandidate) and riskCandidate > 0 and (riskCandidate / close * 100.0) <= maxSlPct
rrOk      = not na(tpCandidate) and not na(riskCandidate) and riskCandidate > 0 and ((tpCandidate - close) / riskCandidate) >= minRr
notInRes  = not avoidResEntry or not resValid or close < resBot

entrySignal = hlFormed and riskOk and rrOk and notInRes and regimeOk and inWindow and not pauseTrading and strategy.position_size == 0 and barstate.isconfirmed

// Risk-based quantity, capped by available spot equity (no leverage).
float qtyRisk = na
if useRiskSizing and riskOk
    rawQty  = strategy.equity * (riskPerTrade / 100.0) / riskCandidate
    maxQty  = strategy.equity / close
    qtyRisk := math.min(rawQty, maxQty)

if entrySignal
    posEntry := close
    posStop  := slCandidate
    posTp    := tpCandidate
    posRisk  := riskCandidate
    posBar   := bar_index
    strategy.entry("Long", strategy.long, qty = useRiskSizing ? qtyRisk : na, comment = "MR Long", alert_message = "MR LONG entry {{ticker}} @ {{close}}")
    S.reset()


// ═══════════════════════════════════════════════════════════════════════════════
//  7. POSITION MANAGEMENT — breakeven, structural trail, exits
// ═══════════════════════════════════════════════════════════════════════════════

inPos = strategy.position_size > 0

if inPos and not na(posEntry) and not na(posRisk)
    // ── Breakeven at the configured R multiple ───────────────────────────────
    if useBreakeven and high >= posEntry + posRisk * beTriggerR
        beLevel = posEntry * (1.0 + beOffsetPct / 100.0)
        if beLevel > nz(posStop, beLevel) and beLevel < low
            posStop := beLevel

    // ── Trail under each new confirmed LTF higher low ────────────────────────
    if useStructTrail and not na(ltfPl)
        cand = ltfPl - nz(ltfAtr) * trailBufAtr
        if cand > nz(posStop, cand) and cand < low
            posStop := cand

// Register / refresh the bracket. Calling strategy.exit every bar updates the
// live stop and limit prices in place.
if inPos or entrySignal
    strategy.exit("Bracket", from_entry = "Long", stop = posStop, limit = posTp, comment_profit = "TP", comment_loss = "SL", alert_message = "MR LONG exit {{ticker}}")

// Optional time stop.
if inPos and useTimeStop and not na(posBar) and (bar_index - posBar) >= timeStopBars
    strategy.close("Long", comment = "TimeStop")

// Optional flatten at session close.
if inPos and useTimeFilter and closeOnSessionEnd and not inWindow
    strategy.close("Long", comment = "SessionEnd")

// Clear per-trade state once flat.
if strategy.position_size == 0 and not entrySignal
    posEntry := na
    posStop  := na
    posTp    := na
    posRisk  := na
    posBar   := na


// ═══════════════════════════════════════════════════════════════════════════════
//  8. VISUALS — zones, trade lines, markers
// ═══════════════════════════════════════════════════════════════════════════════

// ── HTF zone boxes ────────────────────────────────────────────────────────────
var box supBox = na
var box resBox = na

if showZones and barstate.islast
    if supValid
        if na(supBox)
            supBox := box.new(bar_index - zoneDrawBars, supTop, bar_index + zoneExtendRight, supBot, border_color = color.new(color.teal, 40), bgcolor = colSup)
        else
            box.set_lefttop(supBox, bar_index - zoneDrawBars, supTop)
            box.set_rightbottom(supBox, bar_index + zoneExtendRight, supBot)
    if resValid
        if na(resBox)
            resBox := box.new(bar_index - zoneDrawBars, resTop, bar_index + zoneExtendRight, resBot, border_color = color.new(color.maroon, 40), bgcolor = colRes)
        else
            box.set_lefttop(resBox, bar_index - zoneDrawBars, resTop)
            box.set_rightbottom(resBox, bar_index + zoneExtendRight, resBot)

// HTF level lines (plotted, so they carry history unlike the boxes).
plot(supValid ? htfSwingLow  : na, "HTF Support",    color = color.new(color.teal, 0),   style = plot.style_linebr, linewidth = 2)
plot(resValid ? htfSwingHigh : na, "HTF Resistance", color = color.new(color.maroon, 0), style = plot.style_linebr, linewidth = 2)

// ── SL / TP projection lines (staircase for the trailing stop) ────────────────
var line  tpLine   = na
var line  slLine   = na
var float drawnSl  = na

if showTradeLines
    if entrySignal
        tpLine  := line.new(bar_index, posTp,   bar_index + 1, posTp,   color = color.new(color.green, 0), width = 2)
        slLine  := line.new(bar_index, posStop, bar_index + 1, posStop, color = color.new(color.red, 0),   width = 2)
        drawnSl := posStop
    else if inPos
        if not na(tpLine)
            line.set_x2(tpLine, bar_index)
            line.set_y1(tpLine, posTp)
            line.set_y2(tpLine, posTp)
        if not na(slLine)
            if not na(posStop) and posStop != drawnSl
                line.set_x2(slLine, bar_index)                     // freeze the old step
                slLine  := line.new(bar_index, posStop, bar_index + 1, posStop, color = color.new(color.orange, 0), width = 2)
                drawnSl := posStop
            else
                line.set_x2(slLine, bar_index)

// ── Markers ───────────────────────────────────────────────────────────────────
plotshape(entrySignal, title = "Long Entry", style = shape.triangleup, location = location.belowbar, color = color.new(color.lime, 0), size = size.small)
plotshape(showSweepMarks and sweepConfirmedNow, title = "Sweep reclaim", style = shape.xcross, location = location.belowbar, color = color.new(color.orange, 0), size = size.tiny)
plotshape(showSweepMarks and hlFormed, title = "Higher Low", style = shape.circle, location = location.belowbar, color = color.new(color.aqua, 0), size = size.tiny)

if showEntryLabels and entrySignal
    label.new(bar_index, low, text = "LONG " + str.tostring(posEntry, format.mintick) + "\nSL " + str.tostring(posStop, format.mintick) + "\nTP " + str.tostring(posTp, format.mintick), style = label.style_label_up, color = color.new(color.green, 20), textcolor = color.white, size = size.small)

if entrySignal
    alert("MTF MR Scalper LONG " + syminfo.ticker + " entry " + str.tostring(posEntry, format.mintick) + " SL " + str.tostring(posStop, format.mintick) + " TP " + str.tostring(posTp, format.mintick), alert.freq_once_per_bar_close)


// ═══════════════════════════════════════════════════════════════════════════════
//  9. DASHBOARD
// ═══════════════════════════════════════════════════════════════════════════════

// Zone status text.
string zoneStatus = "MID-RANGE"
if not htfOk
    zoneStatus := "⚠ HTF < CHART TF"
else if not supValid or not resValid
    zoneStatus := "AWAITING HTF PIVOTS"
else if close < supBot
    zoneStatus := "BELOW SUPPORT (broken)"
else if close <= supTop
    zoneStatus := "IN SUPPORT ZONE"
else if close >= resTop
    zoneStatus := "ABOVE RESISTANCE (broken)"
else if close >= resBot
    zoneStatus := "IN RESISTANCE ZONE"

// Setup state text.
string setupState = "idle"
if S.sweepOk
    setupState := "sweep reclaimed → awaiting HL"
else if S.sweepPend
    setupState := "below level → awaiting reclaim"
else if S.armed
    setupState := "armed (zone touched)"

// Blocking reason.
string blockedBy = "—"
if pauseTrading
    blockedBy := "NEWS PAUSE"
else if not inWindow
    blockedBy := "OUT OF SESSION"
else if not regimeOk
    blockedBy := not trendOk ? "HTF TREND" : "HTF ADX"

// True max drawdown %, tracked off peak equity (strategy.max_drawdown is a
// currency amount; dividing it by current equity would understate the figure).
var float peakEquity = strategy.initial_capital
peakEquity := math.max(peakEquity, strategy.equity)
ddPct = peakEquity > 0 ? (peakEquity - strategy.equity) / peakEquity * 100.0 : 0.0
var float maxDdPct = 0.0
maxDdPct := math.max(maxDdPct, ddPct)

winRate = strategy.closedtrades > 0 ? strategy.wintrades / strategy.closedtrades * 100.0 : na
profFac = strategy.grossloss > 0 ? strategy.grossprofit / strategy.grossloss : na
avgWin  = strategy.wintrades  > 0 ? strategy.grossprofit / strategy.wintrades  : na
avgLoss = strategy.losstrades > 0 ? strategy.grossloss   / strategy.losstrades : na
openR   = inPos and not na(posEntry) and not na(posRisk) and posRisk > 0 ? (close - posEntry) / posRisk : na

var table dash = table.new(position.top_right, 2, 18, bgcolor = color.new(color.black, 15), border_width = 1, border_color = color.new(color.gray, 60), frame_width = 1, frame_color = color.new(color.gray, 40))

f_row(int r, string k, string v, color vc) =>
    table.cell(dash, 0, r, k, text_color = color.new(color.silver, 0), text_size = size.tiny, text_halign = text.align_left)
    table.cell(dash, 1, r, v, text_color = vc, text_size = size.tiny, text_halign = text.align_right)

if showTable and barstate.islast
    table.cell(dash, 0, 0, "MTF MR SCALPER", text_color = color.white, text_size = size.small, text_halign = text.align_left, bgcolor = color.new(color.blue, 60))
    table.cell(dash, 1, 0, syminfo.ticker + " " + timeframe.period + "m/" + htfRes + "m", text_color = color.white, text_size = size.tiny, text_halign = text.align_right, bgcolor = color.new(color.blue, 60))

    f_row(1,  "HTF zone status", zoneStatus, zoneStatus == "IN SUPPORT ZONE" ? color.lime : zoneStatus == "IN RESISTANCE ZONE" ? color.orange : color.silver)
    f_row(2,  "Support zone",    supValid ? str.tostring(supBot, format.mintick) + " – " + str.tostring(supTop, format.mintick) : "n/a", color.teal)
    f_row(3,  "Resistance zone", resValid ? str.tostring(resBot, format.mintick) + " – " + str.tostring(resTop, format.mintick) : "n/a", color.maroon)
    f_row(4,  "Regime",          regimeOk ? "OK" : "BLOCKED", regimeOk ? color.lime : color.red)
    f_row(5,  "Blocked by",      blockedBy, blockedBy == "—" ? color.silver : color.red)
    f_row(6,  "Setup state",     setupState, S.sweepOk ? color.aqua : S.armed ? color.yellow : color.silver)
    f_row(7,  "Position",        inPos ? "LONG " + str.tostring(strategy.position_size, "#.####") : "FLAT", inPos ? color.lime : color.silver)
    f_row(8,  "Entry",           inPos and not na(posEntry) ? str.tostring(posEntry, format.mintick) : "—", color.white)
    f_row(9,  "Take profit",     inPos and not na(posTp)   ? str.tostring(posTp, format.mintick)   : "—", color.lime)
    f_row(10, "Stop loss",       inPos and not na(posStop) ? str.tostring(posStop, format.mintick) : "—", color.red)
    f_row(11, "Open R",          na(openR) ? "—" : str.tostring(openR, "#.##") + " R", nz(openR) >= 0 ? color.lime : color.red)
    f_row(12, "Closed trades",   str.tostring(strategy.closedtrades), color.white)
    f_row(13, "Win rate",        na(winRate) ? "—" : str.tostring(winRate, "#.#") + " %", nz(winRate) >= 50 ? color.lime : color.orange)
    f_row(14, "Profit factor",   na(profFac) ? "—" : str.tostring(profFac, "#.##"), nz(profFac) >= 1.5 ? color.lime : nz(profFac) >= 1.0 ? color.orange : color.red)
    f_row(15, "Avg W / Avg L",   (na(avgWin) or na(avgLoss) or avgLoss == 0) ? "—" : str.tostring(avgWin / avgLoss, "#.##"), color.white)
    f_row(16, "Max drawdown",    str.tostring(maxDdPct, "#.#") + " %", maxDdPct <= 20 ? color.orange : color.red)
    f_row(17, "Net profit",      str.tostring(strategy.netprofit, "#.##") + " USDT", strategy.netprofit >= 0 ? color.lime : color.red)

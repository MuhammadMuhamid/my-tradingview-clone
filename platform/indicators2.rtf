\cf2 \cb3 //\{\cf4 \cb1 \
\cf2 \cb3 // This script draws trendlines from the pivot points in the price chart.\cf4 \cb1 \
\cf2 \cb3 // \cf4 \cb1 \
\cf2 \cb3 // The input for the function that draws the trendlines is any calculation or function\cf4 \cb1 \
\cf2 \cb3 //  (here this is pivot points, but the core of the script can be used in other implementations too),\cf4 \cb1 \
\cf2 \cb3 //  that most of the time and occasionally produces a 'non n/a' value.\cf4 \cb1 \
\cf2 \cb3 // The trendline function then connects the non n/a values and extends the connections of those points in a trendline.\cf4 \cb1 \
\cf2 \cb3 //\cf4 \cb1 \
\cf2 \cb3 // There is an option to draw the lines from the wicks or from the 'real bodies' of the candles.\cf4 \cb1 \
\cf2 \cb3 // The trendlines can either extend infinitely or only run for an adjustable amount of bars.\cf4 \cb1 \
\cf2 \cb3 //\cf4 \cb1 \
\cf2 \cb3 // There's an option to display trendline breaks\cf4 \cb1 \
\cf2 \cb3 // And the option to display trendlines in color or monochrome\cf4 \cb1 \
\cf2 \cb3 //\cf4 \cb1 \
\cf2 \cb3 //\cf4 \cb1 \
\cf2 \cb3 //      !!! IMPORTANT NOTICE ON THE TRENDLINES !!!\cf4 \cb1 \
\cf2 \cb3 //\cf4 \cb1 \
\cf2 \cb3 //      The SOLID trendlines are NOT REALTIME !!! (they are painted as soon as the pivot point is detected,\cf4 \cb1 \
\cf2 \cb3 //                                                 this delay is due to the lookback period for the pivot points) \cf4 \cb1 \
\cf2 \cb3 //      The DOTTED trendlines are REALTIME !!!\cf4 \cb1 \
\cf2 \cb3 // \cf4 \cb1 \
\cf2 \cb3 // \cf4 \cb1 \
\cf2 \cb3 // --------------------------------\cf4 \cb1 \
\cf2 \cb3 //\cf4 \cb1 \
\cf2 \cb3 //\cf4 \cb1 \
\cf2 \cb3 // To keep track of the high and low pivot points and the time of occurence, these values are stored in a custom DATAFRAME ARRAY.\cf4 \cb1 \
\cf2 \cb3 // This dataframe structure basically turns the standard 1 dimensional Pinescript arrays in a structured 3D dataframe!\cf4 \cb1 \
\
\cf2 \cb3 // !! Feel free to use the df structure in other scripts if you so desire, however a little shoutout would be nice!! ;-)\cf4 \cb1 \
\
\
\cf2 \cb3 // //////////////////////////////////\cf4 \cb1 \
\cf2 \cb3 // / BASIC INFO ON THE DATAFRAME: ///\cf4 \cb1 \
\cf2 \cb3 // //////////////////////////////////\cf4 \cb1 \
\
\cf2 \cb3 // The df is set up as an EXCELL workbook and is devided in SHEETS, ROWS/RECORDS and COLUMNS.\cf4 \cb1 \
\
\cf2 \cb3 // With the use of some purpose-built functions, values can be placed or retrieved in a specific column of a certain row on a certain sheet\cf4 \cb1 \
\cf2 \cb3 //  this can be done by intuitively using sheet_nr, row_nr and column_nr co\'f6rdinates,\cf4 \cb1 \
\cf2 \cb3 //  without having to worry on what exact index of the Pine array this value is located (the functions do these conversions for you)\cf4 \cb1 \
\
\
\cf2 \cb3 // the syntax I propose for the 3D dataframe array has the following structure:\cf4 \cb1 \
\
\cf2 \cb3 //  - the array starts with 3 VALUES describing the DIMENSION INFORMATION, (nr of sheets, rows, columns)\cf4 \cb1 \
\cf2 \cb3 //      these are ignored in the actual calculations and serve as a metadata header (similar to the "location, time,... etc." data that is stored in photo files)\cf4 \cb1 \
\cf2 \cb3 //      so the array always carries it's own info about the nr. of sheets, rows and columns and doesn't need is seperate "info" file!\cf4 \cb1 \
\
\cf2 \cb3 //      To stay consistent with the standard Pinescript (array and [lookback]) indexing:\cf4 \cb1 \
\cf2 \cb3 //      - indexes for sheets and columns start from 0 (first) and run up to the (total nr of sheets or columns) - 1\cf4 \cb1 \
\cf2 \cb3 //      - indexes for rows also start from 0 (most recent, cfr.[lookback]) and run up to the (total nr of rows) - 1\cf4 \cb1 \
\
\cf2 \cb3 //  - this 3 value metadata header is followed by the actual df data\cf4 \cb1 \
\cf2 \cb3 //      the actual data array can consist of (100,000 - 3) usable items,\cf4 \cb1 \
\pard\pardeftab720\partightenfactor0
\cf4 \cb3      \cb1 \
\pard\pardeftab720\partightenfactor0
\cf2 \cb3 //      In a practical example, you can have a df with 3 sheets, containing 6,666 rows with each 5 columns of data (eg. open, high, low, close, volume) in it!!!\cf4 \cb1 \
\cf2 \cb3 //\cf4 \cb1 \
\cf2 \cb3 ///////////////////////////////////\cf4 \cb1 \
\cf2 \cb3 /// SCHEMATIC OF THE STRUCTURE: ///\cf4 \cb1 \
\cf2 \cb3 ///////////////////////////////////\cf4 \cb1 \
\cf2 \cb3 //\cf4 \cb1 \
\cf2 \cb3 ////// (header with dimensions info)\cf4 \cb1 \
\cf2 \cb3 //\cf4 \cb1 \
\cf2 \cb3 // [nr_of_sheets, nr_of_rows/records, nr_of_columns,\cf4 \cb1 \
\cf2 \cb3 //\cf4 \cb1 \
\cf2 \cb3 ////// (actual array data)\cf4 \cb1 \
\cf2 \cb3 // \cf4 \cb1 \
\cf2 \cb3 //          SHEET 0\cf4 \cb1 \
\cf2 \cb3 //  \cf4 \cb1 \
\cf2 \cb3 //            0           1           2           3                   column_index\cf4 \cb1 \
\cf2 \cb3 //  0    record0_val0, record0_val1, record0_val2, record0_val3, ...,\cf4 \cb1 \
\cf2 \cb3 //  1    record1_val0, record1_val1, record1_val2, record1_val3, ...,\cf4 \cb1 \
\cf2 \cb3 //  2    record2_val0, record2_val1, record2_val2, record2_val3, ...,\cf4 \cb1 \
\cf2 \cb3 //  3    ...\cf4 \cb1 \
\cf2 \cb3 //\cf4 \cb1 \
\cf2 \cb3 // row_index\cf4 \cb1 \
\cf2 \cb3 //                   SHEET 1\cf4 \cb1 \
\cf2 \cb3 //           \cf4 \cb1 \
\cf2 \cb3 //                      0           1           2           3                   column_index\cf4 \cb1 \
\cf2 \cb3 //           0    record0_val0, record0_val1, record0_val2, record0_val3, ...,\cf4 \cb1 \
\cf2 \cb3 //           1    record1_val0, record1_val1, record1_val2, record1_val3, ...,\cf4 \cb1 \
\cf2 \cb3 //           2    record2_val0, record2_val1, record2_val2, record2_val3, ...,\cf4 \cb1 \
\cf2 \cb3 //           3    ...\cf4 \cb1 \
\cf2 \cb3 //          \cf4 \cb1 \
\cf2 \cb3 //          row_index\cf4 \cb1 \
\cf2 \cb3 //                                SHEET 2\cf4 \cb1 \
\cf2 \cb3 //                        \cf4 \cb1 \
\cf2 \cb3 //                                   0           1           2           3                   column_index\cf4 \cb1 \
\cf2 \cb3 //                        0    record0_val0, record0_val1, record0_val2, record0_val3, ...,\cf4 \cb1 \
\cf2 \cb3 //                        1    record1_val0, record1_val1, record1_val2, record1_val3, ...,\cf4 \cb1 \
\cf2 \cb3 //                        2    record2_val0, record2_val1, record2_val2, record2_val3, ...,\cf4 \cb1 \
\cf2 \cb3 //                        3    ...                                                          ]\cf4 \cb1 \
\cf2 \cb3 //                       \cf4 \cb1 \
\cf2 \cb3 //                       row_index\cf4 \cb1 \
\cf2 \cb3 //\cf4 \cb1 \
\cf2 \cb3 ////////////////////////////////////\cf4 \cb1 \
\cf2 \cb3 /// DATA MANIPULATION FUNCTIONS: ///\cf4 \cb1 \
\cf2 \cb3 ////////////////////////////////////\cf4 \cb1 \
\cf2 \cb3 //\cf4 \cb1 \
\cf2 \cb3 // A set of functions are implemented to write info to and retrieve info from the dataframe.\cf4 \cb1 \
\cf2 \cb3 //  Of course the possibilities are not limited to the functions here, these were written because they were needed for the script!\cf4 \cb1 \
\cf2 \cb3 //  A whole list of other functions can be easily written for other manipulation purposes.\cf4 \cb1 \
\cf2 \cb3 //\cf4 \cb1 \
\cf2 \cb3 //\cf4 \cb1 \
\cf2 \cb3 // LIST OF FUNCTIONS contained in this script:\cf4 \cb1 \
\cf2 \cb3 // \cf4 \cb1 \
\cf2 \cb3 // - Dataframe initialisation function, builds 3D matrix with dimensional metadata/size in first 3 values //\cf4 \cb1 \
\cf2 \cb3 //      a new df array is built (cfr. the conventions I propose above) containing a certain nr of sheets, records and columns\cf4 \cb1 \
\cf2 \cb3 //\cf4 \cb1 \
\cf2 \cb3 // - function to get dimensional info from 3D matrix\cf4 \cb1 \
\cf2 \cb3 //      This function returns the nr of sheets, rows and columns in the df\cf4 \cb1 \
\cf2 \cb3 // \cf4 \cb1 \
\cf2 \cb3 // - function to get a sheet start and end index from 3D matrix\cf4 \cb1 \
\cf2 \cb3 //      This is mainly used for 1D to 3D index conversions\cf4 \cb1 \
\cf2 \cb3 //\cf4 \cb1 \
\cf2 \cb3 // - function to add a record on the top of a sheet, shift the whole list one down and remove the oldest record\cf4 \cb1 \
\cf2 \cb3 //      (2D version of "unshift" + "pop" but with a whole row at once)\cf4 \cb1 \
\cf2 \cb3 //\cf4 \cb1 \
\cf2 \cb3 // - function to retrieve the values from a record from a certain row/lookback period\cf4 \cb1 \
\cf2 \cb3 //      The values are returned as an array\cf4 \cb1 \
\cf2 \cb3 //\cf4 \cb1 \
\cf2 \cb3 // - function to get/retrieve a single value from a certain sheet, row/lookback period and column\cf4 \cb1 \
\cf2 \cb3 //\cf4 \cb1 \
\cf2 \cb3 // - function to set a single value in a certain sheet, row/lookback period and column\cf4 \cb1 \
\cf2 \cb3 //\cf4 \cb1 \
\cf2 \cb3 // - function to print the matrix\cf4 \cb1 \
\cf2 \cb3 //      This function is mainly used for debugging purposes and displays the array as a 2D matrix notation\cf4 \cb1 \
\cf2 \cb3 //\cf4 \cb1 \
\cf2 \cb3 //\cf4 \cb1 \
\cf2 \cb3 // Enjoy!\cf4 \cb1 \
\cf2 \cb3 // JD.\cf4 \cb1 \

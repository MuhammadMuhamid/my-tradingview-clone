// This Pine Script™ code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
// SR+Trend v9 — MTF pivot S/R + MA trend (MTF) + SuperTrend + LinReg + VWMA + Volume + HH/HL structure
//
// WHAT CHANGED vs v8:
//   ADDED:   Session Time Filter (Logic 1) — restrict entries to UTC hours; auto-close at session end.
//   ADDED:   Entry Bar Body Filter (Logic 2) — reject bearish entry bars exceeding ATR threshold.
//   ADDED:   Vol Exhaust Re-Entry Block (Logic 4) — prevent re-entry near exit zone for N bars.
//   ADDED:   Adaptive TP (Logic 5) — higher R in strong HH-confirmed trend, lower in neutral market.
//   ADDED:   ATR Spike Filter (Logic 6) — block entries during abnormal volatility spikes.
//
// WHAT CHANGED vs v5:
//   REMOVED: All MACD, RSI, ADX, and IMBA (Fair Value Gap / Fib-channel) code.
//   ADDED:   HTF Regime EMA filter (clean ADX replacement — price above rising 4h EMA).
//   ADDED:   Volume Exhaustion exit (new N-bar high on drying volume = distribution top).
//   ADDED:   HL Structure Break exit (confirmed close below last pivot low = early trend invalidation).
//   ADDED:   Break-Even Stop (move SL to entry after +0.75R — kills "gave-back-all-gains" losses).
//   ADDED:   Consecutive-Loss Pause / Choppy-Market Circuit Breaker (blocks re-entry during ranging).
//
// --- 3Commas Signal bot (TradingView Strategy) ---
// 1) 3Commas → Signal bot → Alert type "TradingView Strategy" → copy webhook + JSON "secret" + "bot_uuid".
// 2) Webhook URL (Signal bots only): https://api.3commas.io/signal_bots/webhooks
// 3) TradingView alert: prefer "Order fills only" (not "… and alert()") when Signal delivery = 3Commas.
// 4) Properties → "Recalculate after order is filled": ON vs OFF uses a different backtest timeline.
//    Keep the same setting you used while tuning.
// 5) Alert "Message": paste JSON from 3commas_alert_message_template.json (replace secret + bot_uuid only).
// 6) Chart exchange + symbol must match your Signal bot pair (e.g. BINANCE:APTUSDT).
//@version=6
strategy("MA + R:R Strategy", shorttitle = "MA_RR", overlay = true,
     max_labels_count = 500, max_lines_count = 300,
     initial_capital = 1000, default_qty_type = strategy.cash, default_qty_value = 930,
     commission_type = strategy.commission.percent, commission_value = 0.05,
     slippage = 2, pyramiding = 0,
     calc_on_every_tick = true, calc_on_order_fills = false)

// ── Groups ────────────────────────────────────────────────────────────────────
string G_GEN       = "1 General"
string G_RUNLIM    = "1b Profit-run limit (winning cluster cap)"
string G_TR_MA     = "3 Trend — Moving averages (MTF)"
string G_TR_ST     = "4 Trend — SuperTrend"
string G_TR_LR     = "5 Trend — Linear regression"
string G_TR_VW     = "6a Trend — VWMA (optional)"
string G_TR_LOCAL  = "6d Trend — Local EMA stack (micro)"
string G_TR_VOL    = "6e Volume filter"
string G_TR_HH     = "6f Higher-high structure"
string G_ENT_LONG  = "7 Entries — Long"
string G_ENT_SHRT  = "8 Entries — Short"
string G_EXIT      = "9 Exits — signal-based (soft exits)"
string G_RR        = "9b R:R — swing-low stop + ratio TP"
string G_SPIKE     = "11 Peak / spike filters (anti-chase)"
string G_BTC       = "12 BTC market filter (BTC-specific)"
string G_VIS       = "10 Visualization"
string G_RSI       = "14 RSI (embedded)"
string G_RF        = "18 Indicator — Range Filter"
string G_QT        = "19 Indicator — Q-Trend"
string G_AT        = "20 Indicator — AlphaTrend"
string G_HAC       = "21 Indicator — HACOLT (Heiken-Ashi)"
string G_UT        = "22 Indicator — UT Bot Alerts"

// ── General ───────────────────────────────────────────────────────────────────
useBarConfirm = input.bool(true, "Signals on confirmed bar only", group = G_GEN,
     tooltip = "OFF = entry conditions can go true every tick → same-bar stop/re-entry loops + many 3Commas webhooks. Keep ON for live.")
ordersOnConfirmedBar = input.bool(true, "New entries: bar close only (3Commas)", group = G_GEN,
     tooltip = "When ON, only strategy.entry waits for barstate.isconfirmed. Exits are not delayed.")
cooldownBarsAfterExit = input.int(0, "Min bars after exit before new entry", minval = 0, maxval = 50, group = G_GEN)

// Choppy-market circuit breaker — pauses entries after back-to-back losses.
// Solves the NEAR May 20-21 pattern: 4 consecutive losses in 36h during a sideways range
// where all MA filters remained bullish but every support touch immediately reversed.
useChoppyFilter = input.bool(true, "Pause entries after N consecutive losses", group = G_GEN,
     tooltip = "After maxConsecLoss losing trades in a row, block all new entries for choppyPauseBars bars. Detects distribution / choppy phases that look bullish on the macro but fail at the micro level.")
maxConsecLoss   = input.int(2, "Max consecutive losses before pause", minval = 1, maxval = 10, group = G_GEN,
     tooltip = "2 is the recommended default. Raise to 3 on high win-rate coins where two losses in a row still represent normal variance.")
choppyPauseBars = input.int(20, "Pause duration (bars) after max losses hit", minval = 1, maxval = 500, group = G_GEN,
     tooltip = "On a 5m chart: 20 bars = 100 minutes. Set to 48 for a 4-hour pause. The market usually resolves its range or breaks out within this window.")

// ── Profit-run limit — stop after a profitable winning cluster ────────────────
// Counts consecutive WINNING trades and their combined % profit. Once both the
// trade-count and profit thresholds are hit, new entries pause for a cooldown so
// the strategy doesn't take the final "top" trade of an extended run. A losing
// trade (or the cooldown elapsing) resets the streak.
useRunLimit        = input.bool(false, "Stop entries after a profitable winning run", group = G_RUNLIM,
     tooltip = "After N consecutive winning trades that together made at least the profit % below, pause new entries for the cooldown. Targets the last 'top' trade of a winning cluster. A loss resets the streak.")
runLimTrades       = input.int(3, "Winning trades in the run", minval = 1, maxval = 50, group = G_RUNLIM,
     tooltip = "How many back-to-back winners before the cap can trigger. 3 = after 3 straight wins.")
runLimProfitPct    = input.float(5.0, "Min combined profit % of the run", step = 0.5, minval = 0, group = G_RUNLIM,
     tooltip = "The winners' summed Net PnL % must reach this before entries pause. Both this AND the trade-count must be met.")
runLimPauseBars    = input.int(50, "Pause new entries for N bars after cap hit", minval = 1, maxval = 5000, group = G_RUNLIM,
     tooltip = "Cooldown length once the cap fires. After it elapses the streak resets and entries resume.")

signal_delivery = input.string("3Commas Signal Bot", "Signal delivery",
     options = ["3Commas Signal Bot", "Custom webhook bot", "Off"], group = G_GEN,
     tooltip = "3Commas: add a TradingView alert manually with 3Commas JSON + webhook (see header). Custom: FastAPI bot JSON via Pine alert().")
string ALERT_SECRET  = input.string("REPLACE_ME", "[Custom bot] secret → WEBHOOK_SECRET", group = G_GEN, display = display.none)
float  alert_buy_usdt  = input.float(800.0, "[Custom bot] BUY quote USDT", minval = 1, step = 1, group = G_GEN, display = display.none)
float  alert_sell_base = input.float(0.001, "[Custom bot] SELL base qty",  minval = 0.00000001, step = 0.001, group = G_GEN, display = display.none)
string alert_symbol    = input.string("APTUSDT", "[Custom bot] symbol", group = G_GEN, display = display.none)
use_custom_webhook     = signal_delivery == "Custom webhook bot"

// ── MA MTF trend ──────────────────────────────────────────────────────────────
useMaTrend     = input.bool(false, "Require MA uptrend / downtrend", group = G_TR_MA)
maPrimary      = input.bool(false, "MA trend is PRIMARY (entry trigger)", group = G_TR_MA,
     tooltip = "ON  = MA alignment (close above all enabled rising MAs) TRIGGERS entries (primary signal).\nOFF = MA trend only acts as a confirming FILTER while another primary indicator triggers the entry.")
maBlockWhenNa  = input.bool(true, "MA: block entries while MTF MA is na", group = G_TR_MA)
plotMaLines    = input.bool(false, "Plot MTF MA lines (TF1–TF4)", group = G_TR_MA)
requireMaSlope = input.bool(false, "Require enabled MAs to be rising (slope)", group = G_TR_MA)
// Each MA has its own type (SMA/EMA/WMA/RMA/VWMA/HMA), source (O/H/L/C) and slope lookback.
ma1_en   = input.bool(true,  "TF1", group = G_TR_MA, inline = "m1")
ma1_tf   = input.timeframe("1",   "", group = G_TR_MA, inline = "m1")
ma1_len  = input.int(200, "", group = G_TR_MA, inline = "m1")
ma1_type = input.string("SMA", "", options = ["SMA", "EMA", "WMA", "RMA", "VWMA", "HMA"], group = G_TR_MA, inline = "m1")
ma1_src  = input.string("Close", "", options = ["Open", "High", "Low", "Close"], group = G_TR_MA, inline = "m1")
ma1_slopeLb = input.int(5, "TF1 slope lookback (bars)", minval = 1, maxval = 200, group = G_TR_MA)
ma2_en   = input.bool(false, "TF2", group = G_TR_MA, inline = "m2")
ma2_tf   = input.timeframe("240", "", group = G_TR_MA, inline = "m2")
ma2_len  = input.int(100, "", group = G_TR_MA, inline = "m2")
ma2_type = input.string("SMA", "", options = ["SMA", "EMA", "WMA", "RMA", "VWMA", "HMA"], group = G_TR_MA, inline = "m2")
ma2_src  = input.string("Close", "", options = ["Open", "High", "Low", "Close"], group = G_TR_MA, inline = "m2")
ma2_slopeLb = input.int(5, "TF2 slope lookback (bars)", minval = 1, maxval = 200, group = G_TR_MA)
ma3_en   = input.bool(true,  "TF3", group = G_TR_MA, inline = "m3")
ma3_tf   = input.timeframe("60",  "", group = G_TR_MA, inline = "m3")
ma3_len  = input.int(400, "", group = G_TR_MA, inline = "m3")
ma3_type = input.string("SMA", "", options = ["SMA", "EMA", "WMA", "RMA", "VWMA", "HMA"], group = G_TR_MA, inline = "m3")
ma3_src  = input.string("Close", "", options = ["Open", "High", "Low", "Close"], group = G_TR_MA, inline = "m3")
ma3_slopeLb = input.int(5, "TF3 slope lookback (bars)", minval = 1, maxval = 200, group = G_TR_MA)
ma4_en   = input.bool(false, "TF4", group = G_TR_MA, inline = "m4")
ma4_tf   = input.timeframe("15",  "", group = G_TR_MA, inline = "m4")
ma4_len  = input.int(50, "", group = G_TR_MA, inline = "m4")
ma4_type = input.string("SMA", "", options = ["SMA", "EMA", "WMA", "RMA", "VWMA", "HMA"], group = G_TR_MA, inline = "m4")
ma4_src  = input.string("Close", "", options = ["Open", "High", "Low", "Close"], group = G_TR_MA, inline = "m4")
ma4_slopeLb = input.int(5, "TF4 slope lookback (bars)", minval = 1, maxval = 200, group = G_TR_MA)

// ── SuperTrend ────────────────────────────────────────────────────────────────
useSuperTrend = input.bool(false, "Require SuperTrend alignment", group = G_TR_ST)
stTf          = input.timeframe("5", "SuperTrend timeframe", group = G_TR_ST)
stAtrLen      = input.int(15, "ATR period", minval = 1, group = G_TR_ST)
stMult        = input.float(2.5, "Multiplier", step = 0.1, minval = 0.1, group = G_TR_ST)
stSrc         = input.source(hl2, "Source (same TF as chart only)", group = G_TR_ST)

// ── LinReg ────────────────────────────────────────────────────────────────────
useLinReg  = input.bool(false, "Use LinReg candle filter", group = G_TR_LR)
lrTf       = input.timeframe("5", "LinReg timeframe", group = G_TR_LR)
lrLen      = input.int(12, "LinReg length", minval = 2, group = G_TR_LR)
sigLen     = input.int(11, "Signal line length (chart TF)", minval = 1, group = G_TR_LR)
sigUseSma  = input.bool(false, "Signal = SMA (off = EMA)", group = G_TR_LR)
plotLinReg = input.bool(false, "Plot LinReg close line", group = G_TR_LR)

// ── VWMA 1 ────────────────────────────────────────────────────────────────────
useVwmaTrend = input.bool(false, "Require close above VWMA (HTF)", group = G_TR_VW)
vwmaTf       = input.timeframe("240", "VWMA timeframe", group = G_TR_VW)
vwmaLen      = input.int(200, "VWMA length", minval = 1, group = G_TR_VW)
plotVwmaLine = input.bool(false, "Plot VWMA line", group = G_TR_VW)

// ── Local EMA stack (micro) ───────────────────────────────────────────────────
useLocalTrend    = input.bool(false, "Require local EMA trend alignment", group = G_TR_LOCAL,
     tooltip = "Fast EMA > slow EMA on the chosen TF confirms local directional bias. Use 5m to block entries when the 5m structure is down inside an HTF uptrend.")
localTrendTf     = input.timeframe("5", "Local EMA timeframe", group = G_TR_LOCAL)
localEmaFast     = input.int(21, "Fast EMA period", minval = 2, maxval = 200, group = G_TR_LOCAL)
localEmaSlow     = input.int(34, "Slow EMA period",  minval = 2, maxval = 500, group = G_TR_LOCAL)
requireAboveFast = input.bool(true, "Also require close above fast EMA (long)", group = G_TR_LOCAL,
     tooltip = "For longs: close must also be above the fast EMA. Adds momentum confirmation.")
plotLocalEma     = input.bool(false, "Plot local EMA lines", group = G_TR_LOCAL)

// ── Volume filter ─────────────────────────────────────────────────────────────
useVolumeFilter = input.bool(false, "Require above-average volume on entry", group = G_TR_VOL)
volTf           = input.timeframe("", "Volume timeframe (blank = chart)", group = G_TR_VOL,
     tooltip = "Timeframe used to evaluate volume vs its SMA for the entry filter. Blank = chart timeframe.")
volMaLen        = input.int(20, "Volume SMA length", minval = 5, group = G_TR_VOL)
volMultMin      = input.float(1.2, "Min volume (× SMA)", step = 0.1, minval = 0.1, group = G_TR_VOL,
     tooltip = "1.0 = at-least-average volume; 1.5 = 50% above average.")
plotVolSma      = input.bool(false, "Plot volume SMA line", group = G_TR_VOL)

// ── Higher-high structure filter ──────────────────────────────────────────────
useHhStructure = input.bool(false, "Require higher-high structure (HTF longs)", group = G_TR_HH,
     tooltip = "Last confirmed pivot high on the chosen TF must be above the prior pivot high. Validates real HTF uptrend structure.")
hhTf           = input.timeframe("15", "Higher-high timeframe", group = G_TR_HH)
hhPivotLen     = input.int(9, "Pivot length (HH TF)", minval = 3, maxval = 30, group = G_TR_HH)
plotHhStruct   = input.bool(false, "Plot higher-high structure (last/prior pivot highs)", group = G_TR_HH,
     tooltip = "Plots the most recent and prior confirmed pivot highs on the HH timeframe so you can see the structure the filter evaluates. Works even when the filter itself is off.")

// ── Long entries ──────────────────────────────────────────────────────────────
long_en          = input.bool(true, "Enable longs", group = G_ENT_LONG)
lrLongRule       = input.string("Green candle", "LinReg long rule", options = ["Green candle", "Close > signal", "Both"], group = G_ENT_LONG)

// Logic 2 — Entry Bar Body Filter
// Rejects bearish entry candles whose body exceeds a fraction of ATR.
// A bearish close on the entry bar = momentum already shifted against you; skip it.
useBodyFilter    = input.bool(false, "Body filter: reject bearish entry bar (Logic 2)", group = G_ENT_LONG,
     tooltip = "Skips entries where the trigger bar is bearish AND its body (open−close) exceeds entryBodyAtrMult × ATR. A big bearish close on the setup bar is a momentum warning — skip it and wait for the next bar.")
entryBodyAtrMult = input.float(0.3, "Body filter: max bearish body size (× ATR)", step = 0.05, minval = 0.05, group = G_ENT_LONG,
     tooltip = "0.3 = reject only if the bearish body is larger than 30% of ATR. Increase to be more lenient (0.5 allows a medium bearish bar). Decrease to be stricter.")

// ── Short entries ─────────────────────────────────────────────────────────────
short_en     = input.bool(false, "Enable shorts at resistance", group = G_ENT_SHRT)
lrShortRule  = input.string("Red candle", "LinReg short rule", options = ["Red candle", "Close < signal", "Both"], group = G_ENT_SHRT)

// ── Exits (signal-based) — ATR primitive ──────────────────────────────────────
atrLenExit = input.int(7, "ATR length (risk)", minval = 1, group = G_EXIT)

// ── R:R — swing-low stop + ratio TP ───────────────────────────────────────────
// Dedicated risk:reward mode for longs: SL placed below the previous swing low,
// TP at an adjustable reward:risk multiple. When ON, it overrides the SL/TP for
// long entries and uses the single-target bracket (partial-TP engine is bypassed).
useRR      = input.bool(false, "Use R:R mode (swing-low SL + ratio TP) — longs", group = G_RR,
     tooltip = "ON = long SL is set just below the previous swing low and TP is taken at the reward:risk ratio below. Overrides the group-9 SL/TP and the partial-TP engine for longs. Shorts are unaffected.")
rrSwingLb  = input.int(10, "Swing low lookback (bars)", minval = 2, maxval = 200, group = G_RR,
     tooltip = "Number of bars used to find the previous swing low. The stop is placed below this low.")
rrBufAtr   = input.float(0.1, "SL buffer below swing low (× ATR)", step = 0.05, minval = 0.0, group = G_RR,
     tooltip = "Extra distance below the swing low, in ATR units, so the stop sits clear of the exact wick. 0 = exactly at the swing low.")
rrRatio    = input.float(2.0, "Reward : Risk ratio (TP)", step = 0.25, minval = 0.25, group = G_RR,
     tooltip = "Final take-profit distance as a multiple of risk. 2.0 = 1:2. This is the runner's target when partial TPs are on, or the single target when they are off. Adjustable.")
minSlDistAtr = input.float(0.25, "Floor: min SL distance from entry (× ATR)", step = 0.05, minval = 0.05, group = G_RR,
     tooltip = "The stop is never placed closer than this many ATRs below entry, even if the swing low is very near price. Sets the minimum risk used for the reward:risk target.")
plotRR     = input.bool(false, "Plot R:R levels (live SL + TP)", group = G_RR,
     tooltip = "Plots the active long's stop (incl. trailing) and the reward:risk target. Also shows the PROJECTED SL/TP while flat so you can see where they would sit on the next entry.")

// R:R — multiple partial take-profits (percentage-based, toggleable)
rrUsePartialTp = input.bool(false, "R:R: take partial TPs (%) — TP1 / TP2 + runner", group = G_RR,
     tooltip = "ON = scale out at two percentage levels (TP1, TP2) and let the remainder run to the reward:risk target. OFF = single exit at the reward:risk target.")
rrTp1Pct  = input.float(2.0,  "TP1 — price move %", step = 0.1, minval = 0.1, group = G_RR, inline = "rtp1")
rrTp1Size = input.float(40.0, "close % of pos",     step = 5, minval = 1, maxval = 100, group = G_RR, inline = "rtp1")
rrTp2Pct  = input.float(4.0,  "TP2 — price move %", step = 0.1, minval = 0.1, group = G_RR, inline = "rtp2")
rrTp2Size = input.float(30.0, "close % of pos",     step = 5, minval = 1, maxval = 100, group = G_RR, inline = "rtp2")

// R:R — trailing stop loss (percentage-based, toggleable)
rrUseTrailSl = input.bool(false, "R:R: trailing stop (%)", group = G_RR,
     tooltip = "ON = a percentage trailing stop ratchets up under price (never down). Combines with the swing-low stop and break-even — the highest of them is used.")
rrTrailPct   = input.float(3.0, "Trailing stop distance (%)", step = 0.1, minval = 0.1, group = G_RR,
     tooltip = "Stop trails this % below the close. 3 = stop sits 3% under price and only moves up.")
rrTrailActPct = input.float(0.0, "Trailing: activate after +% in profit (0 = once green)", step = 0.1, minval = 0.0, group = G_RR,
     tooltip = "Trailing stop only arms after price is this % above entry. 0 = arm as soon as the trade is in profit.")

// ── Peak / spike filters (anti-chase) — block longs that chase extended moves ──
// 1) Over-extension vs MA: reject entries too far above a reference EMA.
useExtFilter = input.bool(false, "Block entries too far above MA (over-extension)", group = G_SPIKE,
     tooltip = "Reject a long when close is more than the distance below ABOVE the reference EMA. Targets entries that chase a stretched micro-top; pullback/early-trend entries near the MA still pass.")
extRefLen    = input.int(50, "Reference EMA length", minval = 1, group = G_SPIKE)
extMode      = input.string("ATR", "Extension distance mode", options = ["ATR", "Percent"], group = G_SPIKE)
extMaxAtr    = input.float(2.5, "Max distance above EMA (× ATR)", step = 0.1, minval = 0.1, group = G_SPIKE)
extMaxPct    = input.float(3.0, "Max distance above EMA (%)", step = 0.1, minval = 0.1, group = G_SPIKE)
// 2) Parabolic run guard: reject entries after an over-fast recent run.
usePeakRun   = input.bool(false, "Block entries after parabolic run", group = G_SPIKE,
     tooltip = "Reject a long when price has already risen more than the limit over the last N bars (blow-off / pyramiding into a top).")
runLb        = input.int(20, "Run lookback (bars)", minval = 2, maxval = 500, group = G_SPIKE)
runMode      = input.string("Percent", "Run measured in", options = ["Percent", "ATR"], group = G_SPIKE)
runMaxPct    = input.float(12.0, "Max rise over lookback (%)", step = 0.5, minval = 0.1, group = G_SPIKE)
runMaxAtr    = input.float(6.0, "Max rise over lookback (× ATR)", step = 0.5, minval = 0.1, group = G_SPIKE)
// 3) ATR spike filter: reject entries on climax volatility bars.
useAtrSpike  = input.bool(false, "Block entries on ATR volatility spikes", group = G_SPIKE,
     tooltip = "Reject a long when current ATR is far above its recent average (climax / panic bars).")
atrSpikeAvgLen = input.int(20, "ATR spike: average lookback (bars)", minval = 2, group = G_SPIKE)
atrSpikeMaxMult = input.float(1.8, "ATR spike: max ATR (× average)", step = 0.1, minval = 1.0, group = G_SPIKE)
// 4) Upper-wick rejection: skip entries on bars with a big upper shadow.
useWickFilter = input.bool(false, "Block entries with large upper wick (rejection)", group = G_SPIKE,
     tooltip = "Reject a long when the trigger bar's upper wick (high − max(open,close)) exceeds the limit — a rejection at the highs.")
wickMaxAtr    = input.float(0.6, "Max upper wick (× ATR)", step = 0.05, minval = 0.05, group = G_SPIKE)
plotExtBand   = input.bool(false, "Plot over-extension ceiling (ref EMA + limit)", group = G_SPIKE,
     tooltip = "Plots the reference EMA and the over-extension ceiling. Longs are blocked while close is above the ceiling.")

// ── BTC market filter (BTC-specific) — only allow entries when BTC is trending up ──
// All three checks below are computed on the BTC symbol, independent of the chart coin.
btcEnable    = input.bool(false, "Require BTC uptrend to allow entries", group = G_BTC,
     tooltip = "Master switch. When ON, long entries are only allowed when the enabled BTC checks below confirm BTC is in an uptrend — computed on BTC data even though the strategy runs on this coin.")
btcSym       = input.symbol("BINANCE:BTCUSDT", "BTC symbol", group = G_BTC,
     tooltip = "The symbol used for the BTC trend checks. Use a feed you have access to (BINANCE:BTCUSDT is universal).")
// BTC moving averages (like Section 3, but on BTC)
useBtcMa        = input.bool(true, "BTC: require MA uptrend", group = G_BTC)
requireBtcMaSlope = input.bool(true, "BTC: require MAs rising (slope)", group = G_BTC)
btcMa1_en   = input.bool(true,  "BTC MA1", group = G_BTC, inline = "b1")
btcMa1_tf   = input.timeframe("60",  "", group = G_BTC, inline = "b1")
btcMa1_len  = input.int(200, "", group = G_BTC, inline = "b1")
btcMa1_type = input.string("SMA", "", options = ["SMA", "EMA", "WMA", "RMA", "VWMA", "HMA"], group = G_BTC, inline = "b1")
btcMa1_src  = input.string("Close", "", options = ["Open", "High", "Low", "Close"], group = G_BTC, inline = "b1")
btcMa1_slopeLb = input.int(5, "BTC MA1 slope lookback (bars)", minval = 1, maxval = 200, group = G_BTC)
btcMa2_en   = input.bool(false, "BTC MA2", group = G_BTC, inline = "b2")
btcMa2_tf   = input.timeframe("240", "", group = G_BTC, inline = "b2")
btcMa2_len  = input.int(100, "", group = G_BTC, inline = "b2")
btcMa2_type = input.string("SMA", "", options = ["SMA", "EMA", "WMA", "RMA", "VWMA", "HMA"], group = G_BTC, inline = "b2")
btcMa2_src  = input.string("Close", "", options = ["Open", "High", "Low", "Close"], group = G_BTC, inline = "b2")
btcMa2_slopeLb = input.int(5, "BTC MA2 slope lookback (bars)", minval = 1, maxval = 200, group = G_BTC)

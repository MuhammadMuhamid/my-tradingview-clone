# ── secrets ──
# Never commit runtime credentials: DATABASE_URL, ALERT_ENCRYPTION_KEY,
# SESSION_SECRET, ADMIN_PASSWORD_HASH and webhook secrets all live in these.
.env
.env.*
!.env.example
!.env.local.example
!*.env.example
*.pem
*.key

# ── dependencies / build output ──
node_modules/
.next/
dist/
*.tsbuildinfo
__pycache__/
*.pyc

# ── local database ──
.pgdata/


# ── build/deploy bundles (one is 426 MB; GitHub caps files at 100 MB) ──
*.tar.gz
*.tgz
*.zip

# ── logs and local scratch ──
*.log
.DS_Store
platform/backend/regime_wf/
platform/backend/parity/
platform/backend/backups/
platform/backend/dist/

# ── deploy bundles (rebuilt on demand; may embed config) ──
platform/deployment/aws/src-*.tar.gz
platform/deployment/aws/configs-*.tar.gz

# ── logs and scratch ──
*.log
*.tmp.json
*.tmp.ts
dep.tmp.json
ptest.tmp.ts

# ── macOS ──
.DS_Store

# ── downloaded market data & tuning databases ──
# Re-fetchable from Binance; keeping it out keeps the repo cloneable.
backtest-spot/data/
backtest-spot/optuna_dbs/
scripts/binance_ohlc/
*.csv
*.db

# ── graphify generated output ──
# Regenerate with `graphify update .`; the dated snapshots are history only.
graphify-out/20*/
graphify-out/cache/

# ── generated result streams (every optimizer writes these) ──
*.jsonl
backtestingsystems/trees/*/folds/
backtestingsystems/trees/*/*.pid



# ── backtesting systems live in their own repository ──
# Separated 2026-08-22. platform/ (this repo) is the TradingView clone only;
# every optimizer, its results and the legacy systems moved to
# backtestingsystems/, which has its own .git and pushes to
# github.com/MuhammadMuhamid/pythoncryptobacktesingsystems
backtestingsystems/

# ── stray working copies ──
# A duplicate of the whole project made by hand ("platform copy", "platform 2",
# …). Committing one doubles the repo and creates a second, silently diverging
# source of truth for every file.
platform copy/
platform [0-9]*/
*-copy/

# ── secrets ──
# Never commit runtime credentials: DATABASE_URL, ALERT_ENCRYPTION_KEY,
# SESSION_SECRET, ADMIN_PASSWORD_HASH and webhook secrets all live in these.
.env
.env.*
!.env.example
!.env.local.example
!*.env.example
*.pem
*.key

# ── dependencies / build output ──
node_modules/
.next/
dist/
*.tsbuildinfo
__pycache__/
*.pyc

# ── local database ──
.pgdata/

# ── optimizer result data (tens of GB of generated JSON) ──
# The TREES themselves are tracked (code, config, coins.txt, README) — only the
# generated data underneath them is excluded. Do not re-add a blanket
# `optimizer*/` rule: git will not descend into an excluded directory, so the
# per-tree documentation would silently vanish from the repo.
backtestingsystems/trees/*/results/
backtestingsystems/trees/*/best/
backtestingsystems/trees/*/index/
backtestingsystems/trees/*/archive/
backtestingsystems/trees/*/__pycache__/
backtestingsystems/trees/*/SUMMARY.json
backtestingsystems/trees/*/.optimizer.pid
backtestingsystems/trees/*/service*.log
backtestingsystems/trees/*/seeds.json
# one-off analysis scratch files
backtestingsystems/trees/*/sens.json
backtestingsystems/trees/*/picks*.json
backtestingsystems/trees/*/verified*.json
platform/backend/backups/

# ── build/deploy bundles (one is 426 MB; GitHub caps files at 100 MB) ──
*.tar.gz
*.tgz
*.zip

# ── logs and local scratch ──
*.log
.DS_Store
platform/backend/regime_wf/
platform/backend/parity/
platform/backend/backups/
platform/backend/dist/

# ── deploy bundles (rebuilt on demand; may embed config) ──
platform/deployment/aws/src-*.tar.gz
platform/deployment/aws/configs-*.tar.gz

# ── logs and scratch ──
*.log
*.tmp.json
*.tmp.ts
dep.tmp.json
ptest.tmp.ts

# ── macOS ──
.DS_Store

# ── downloaded market data & tuning databases ──
# Re-fetchable from Binance; keeping it out keeps the repo cloneable.
backtest-spot/data/
backtest-spot/optuna_dbs/
scripts/binance_ohlc/
*.csv
*.db

# ── graphify generated output ──
# Regenerate with `graphify update .`; the dated snapshots are history only.
graphify-out/20*/
graphify-out/cache/

# ── generated result streams (every optimizer writes these) ──
*.jsonl
backtestingsystems/trees/*/folds/
backtestingsystems/trees/*/*.pid

# ── backtestingsystems: generated data and vendored deps ──
backtestingsystems/node_modules
backtestingsystems/data/
backtestingsystems/legacy/*/data/
backtestingsystems/legacy/*/optuna_dbs/
backtestingsystems/legacy/**/__pycache__/
backtestingsystems/**/*.csv
